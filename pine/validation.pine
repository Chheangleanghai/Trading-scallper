//@version=6
indicator("Smart Scalper synthetic assertions", overlay=true)
// Pure predicates shared by the engine and the standalone synthetic Pine test harness.
breakConfirmed(int direction, float trigger, float o, float c) =>
    direction == 1 ? c > trigger and c > o : c < trigger and c < o
retestConfirmed(int direction, float lower, float upper, float h, float l, float o, float c) =>
    h >= lower and l <= upper and (direction == 1 ? c > upper and c > o : c < lower and c < o)
rangeSweep(int direction, float lower, float upper, float h, float l, float c) =>
    direction == 1 ? l < lower and c > lower and c < upper : h > upper and c < upper and c > lower
pivotSweep(int direction, float level, float h, float l, float c) =>
    direction == 1 ? l < level and c > level : h > level and c < level
zoneDeparture(int direction, float swingLevel, float previousClose, float previousOpen, float o, float c, bool displaced) =>
    displaced and (direction == 1 ? c > o and previousClose < previousOpen and c > swingLevel and previousClose <= swingLevel : c < o and previousClose > previousOpen and c < swingLevel and previousClose >= swingLevel)
trendPullback(int direction, bool trend, float fast, float slow, float h, float l, float c, float atrValue, float depth) =>
    trend and (direction == 1 ? l <= fast and l >= slow - atrValue * depth and c > slow : h >= fast and h <= slow + atrValue * depth and c < slow)
compressedRange(float upper, float lower, float atrValue, float width) =>
    upper > lower and upper - lower <= atrValue * width
qmPattern(int direction, int firstType, float p0, float p1, float p2, float p3, float p4, float c) =>
    direction == 1 ? firstType == -1 and p2 < p0 and p3 > p1 and p4 > p2 and c > p0 : firstType == 1 and p2 > p0 and p3 < p1 and p4 < p2 and c < p0
orderedPrices(int direction, float planned, float stopPrice, float targetOne, float targetTwo, float targetThree) =>
    direction == 1 ? stopPrice < planned and planned < targetOne and targetOne < targetTwo and targetTwo < targetThree : stopPrice > planned and planned > targetOne and targetOne > targetTwo and targetTwo > targetThree
qualityScore(int structure, int liquidity, bool aligned, bool rr, bool volatility, bool session) =>
    structure + liquidity + 20 + (aligned ? 15 : 0) + (rr ? 10 : 0) + (volatility ? 10 : 0) + (session ? 5 : 0)
tightenStop(int direction, float current, float proposed) =>
    direction == 1 ? math.max(current, proposed) : math.min(current, proposed)

rrFeasible(int direction, float planned, float stopPrice, float targetPrice, float minimum, float tick) =>
    float riskTicks = tick > 0 ? math.round(direction * (planned - stopPrice) / tick) : na
    float rewardTicks = tick > 0 ? math.round(direction * (targetPrice - planned) / tick) : na
    riskTicks > 0 and rewardTicks >= math.ceil(riskTicks * minimum - 0.000000001)

// Time inputs are absolute timestamps. Require the whole signal bar inside the window.
researchBarAllowed(bool enabled, int startTime, int endTime, int barOpen, int barClose) =>
    not enabled or (endTime > startTime and barOpen >= startTime and barClose < endTime)
directionAllowed(string selection, int direction) =>
    (direction == 1 or direction == -1) and (selection == 'Both' or (selection == 'BUY only' and direction == 1) or (selection == 'SELL only' and direction == -1))
planSlotAvailable(bool isActive, bool isPending, bool brokerOccupied, bool cancelling) =>
    not isActive and not isPending and not brokerOccupied and not cancelling

// Consume a confirmed swing only once. Wick touches and repeated recrosses are not new BOS.
freshStructureBreak(int direction, float level, int pivotId, int consumedId, float previousClose, float currentClose) =>
    bool known = not na(level) and not na(pivotId) and (na(consumedId) or pivotId != consumedId)
    known and (direction == 1 ? previousClose <= level and currentClose > level : direction == -1 ? previousClose >= level and currentClose < level : false)
uniqueStructureDirection(bool upward, bool downward) =>
    upward == downward ? 0 : upward ? 1 : -1
structureBreakTime(array<int> pivotIds, array<int> breakBars, int targetId) =>
    int found = na
    if array.size(pivotIds) == array.size(breakBars) and array.size(pivotIds) > 0 and not na(targetId)
        for i = 0 to array.size(pivotIds) - 1
            if array.get(pivotIds, i) == targetId
                found := array.get(breakBars, i)
    found
qmQualified(bool geometry, int necklineBreakBar, int headConfirmedBar, int shoulderConfirmedBar) =>
    geometry and not na(necklineBreakBar) and necklineBreakBar > headConfirmedBar and necklineBreakBar <= shoulderConfirmedBar

// Same mandatory filter conjunction as earlier versions, with an explicit first-failure reason.
candidateRejection(bool windowOK, bool sideOK, bool invalidationOK, bool targetsOK, bool fibOK, bool discountOK, bool volatilityOK, bool paused, bool sessionOK, bool trendOK, bool emaOK, bool stopOK, bool distanceOK, bool rrOK, bool pricesOK, bool quotaOK, bool cooldownOK, int score, int requiredScore) =>
    not windowOK ? 'Outside research date window' : not sideOK ? 'Direction disabled' : not invalidationOK ? 'Missing structural invalidation' : not targetsOK ? 'Insufficient structure targets' : not fibOK ? 'Fibonacci location filter' : not discountOK ? 'Premium/discount filter' : not volatilityOK ? 'ATR volatility filter' : paused ? 'Manual news pause' : not sessionOK ? 'Outside selected session' : not trendOK ? 'Setup opposes H1 trend' : not emaOK ? 'EMA alignment filter' : not stopOK ? 'Stop distance invalid' : not distanceOK ? 'Entry too far from setup' : not rrOK ? 'Minimum reward/risk not met' : not pricesOK ? 'Invalid Entry/SL/TP order' : not quotaOK ? 'Session plan limit' : not cooldownOK ? 'Signal cooldown' : score < requiredScore ? 'Quality below threshold' : ''
readinessState(int direction, bool pendingOrder, bool activeTrade, bool triggered) =>
    direction != 1 and direction != -1 ? 'WAIT' : pendingOrder ? (direction == 1 ? 'BUY READY' : 'SELL READY') : activeTrade ? (direction == 1 ? (triggered ? 'BUY CONFIRMED' : 'BUY ACTIVE (sim.)') : (triggered ? 'SELL CONFIRMED' : 'SELL ACTIVE (sim.)')) : 'WAIT'

// Artificial unit-test prices only. Run this standalone script manually in TradingView.
expect(bool result, string message) =>
    if not result
        runtime.error('Synthetic assertion failed: ' + message)
if barstate.isfirst
    expect(rangeSweep(1, 100, 110, 106, 99, 103), 'B bullish CRT reclaim')
    expect(rangeSweep(-1, 100, 110, 111, 104, 107), 'B bearish CRT reclaim')
    expect(not rangeSweep(1, 100, 110, 106, 99, 99.5), 'B no reclaim rejected')
    expect(not rangeSweep(1, 100, 110, 112, 99, 111), 'B close outside range rejected')
    expect(pivotSweep(1, 100, 105, 99, 102), 'C bullish pivot false breakout')
    expect(pivotSweep(-1, 110, 111, 106, 108), 'C bearish pivot false breakout')
    expect(not pivotSweep(1, 100, 105, 100, 102), 'C must actually sweep')
    expect(breakConfirmed(1, 105, 104, 106), 'B/C bullish later confirmation')
    expect(breakConfirmed(-1, 105, 106, 104), 'B/C bearish later confirmation')
    expect(not breakConfirmed(1, 105, 107, 106), 'B/C counter-direction candle rejected')
    expect(retestConfirmed(1, 100, 102, 106, 101, 103, 105), 'A/D bullish retest/rejection')
    expect(retestConfirmed(-1, 100, 102, 101, 96, 99, 97), 'A/D bearish retest/rejection')
    expect(not retestConfirmed(1, 100, 102, 108, 103, 104, 106), 'A/D no touch rejected')
    expect(not retestConfirmed(1, 100, 102, 104, 101, 102, 101.5), 'A/D no rejection rejected')
    expect(zoneDeparture(1, 105, 101, 103, 102, 107, true), 'E bullish departure')
    expect(zoneDeparture(-1, 100, 104, 102, 103, 98, true), 'E bearish departure')
    expect(not zoneDeparture(1, 105, 101, 103, 102, 107, false), 'E displacement required')
    expect(not zoneDeparture(1, 105, 103, 101, 102, 107, true), 'E opposite origin required')
    expect(trendPullback(1, true, 105, 103, 108, 104, 106, 2, 0.3), 'F bullish pullback')
    expect(trendPullback(-1, true, 103, 105, 104, 100, 102, 2, 0.3), 'F bearish pullback')
    expect(not trendPullback(1, false, 105, 103, 108, 104, 106, 2, 0.3), 'F crossover without structure rejected')
    expect(not trendPullback(1, true, 105, 103, 108, 100, 106, 2, 0.3), 'F deep overshoot rejected')
    expect(compressedRange(106, 100, 2, 3), 'G compressed range accepted')
    expect(not compressedRange(107, 100, 2, 3), 'G wide range rejected')
    expect(not compressedRange(100, 100, 2, 3), 'G zero range rejected')
    expect(qmPattern(1, -1, 100, 110, 95, 112, 101, 104), 'H bullish five-pivot QM')
    expect(qmPattern(-1, 1, 110, 100, 115, 98, 109, 106), 'H bearish five-pivot QM')
    expect(not qmPattern(1, -1, 100, 110, 101, 112, 103, 104), 'H missing head rejected')
    expect(not qmPattern(1, -1, 100, 110, 95, 109, 101, 104), 'H missing neckline break rejected')
    expect(orderedPrices(1, 100, 99, 101, 102, 103), 'Long risk ladder')
    expect(orderedPrices(-1, 100, 101, 99, 98, 97), 'Short risk ladder')
    expect(not orderedPrices(1, 100, 100, 101, 102, 103), 'Zero risk rejected')
    expect(not orderedPrices(1, 100, 99, 101, 101, 103), 'Rounded duplicate targets rejected')
    expect(qualityScore(20, 20, true, true, true, true) == 100, 'Maximum quality')
    expect(qualityScore(20, 0, true, true, true, true) == 80, 'Trend setup no liquidity credit')
    expect(tightenStop(1, 99, 98) == 99, 'Long stop never widens')
    expect(tightenStop(-1, 101, 102) == 101, 'Short stop never widens')
    expect(tightenStop(1, 99, 100) == 100, 'Long stop tightens')
    expect(tightenStop(-1, 101, 100) == 100, 'Short stop tightens')
    expect(rrFeasible(1, 4000.01, 3999.98, 4000.07, 2, 0.01), 'Exact long 2R survives floating error')
    expect(rrFeasible(-1, 4000.07, 4000.10, 4000.01, 2, 0.01), 'Exact short 2R survives floating error')
    expect(not rrFeasible(1, 4000.01, 3999.98, 4000.06, 2, 0.01), 'One tick below 2R rejected')
    expect(not rrFeasible(1, 4000.01, 4000.01, 4000.07, 2, 0.01), 'Zero tick risk rejected')
    expect(not rrFeasible(1, 100, 99.97, 100.04, 1.5, 0.01), 'Fractional required reward rounds upward')
    expect(researchBarAllowed(false, 200, 100, 0, 50), 'Disabled research window allows history')
    expect(researchBarAllowed(true, 100, 300, 100, 200), 'Research start is inclusive')
    expect(not researchBarAllowed(true, 100, 300, 99, 200), 'Bar overlapping research start rejected')
    expect(not researchBarAllowed(true, 100, 300, 200, 300), 'Research end is exclusive')
    expect(not researchBarAllowed(true, 300, 100, 150, 200), 'Inverted research window rejected')
    expect(directionAllowed('Both', 1) and directionAllowed('Both', -1), 'Both directions enabled')
    expect(directionAllowed('BUY only', 1) and not directionAllowed('BUY only', -1), 'Long only enforced')
    expect(directionAllowed('SELL only', -1) and not directionAllowed('SELL only', 1), 'Short only enforced')
    expect(not directionAllowed('Both', 0), 'Neutral direction rejected')
    expect(planSlotAvailable(false, false, false, false), 'Free plan slot available')
    expect(not planSlotAvailable(false, false, false, true), 'Cancelled order cannot be replaced on same bar')
    expect(not planSlotAvailable(true, false, false, false), 'Active trade blocks replacement')
    expect(not planSlotAvailable(false, true, false, false), 'Pending plan blocks replacement')
    expect(not planSlotAvailable(false, false, true, false), 'Broker position blocks replacement')
    expect(freshStructureBreak(1, 100, 10, na, 99, 101), 'Fresh bullish closing break')
    expect(freshStructureBreak(-1, 100, 10, na, 101, 99), 'Fresh bearish closing break')
    expect(not freshStructureBreak(1, 100, 10, 10, 99, 101), 'Consumed pivot cannot repeat BOS')
    expect(freshStructureBreak(1, 100, 11, 10, 99, 101), 'New confirmed pivot may break same price')
    expect(not freshStructureBreak(1, 100, 10, na, 99, 100), 'Touch is not a closing break')
    expect(not freshStructureBreak(1, 100, 10, na, 99, 99.5), 'Wick-only break rejected')
    expect(not freshStructureBreak(1, 100, 10, na, 101, 102), 'Already beyond level is not a fresh cross')
    expect(not freshStructureBreak(1, na, 10, na, 99, 101), 'Unknown level rejected')
    expect(not freshStructureBreak(1, 100, na, na, 99, 101), 'Unconfirmed pivot ID rejected')
    expect(not freshStructureBreak(0, 100, 10, na, 99, 101), 'Invalid structure direction rejected')
    expect(qmQualified(true, 15, 10, 20), 'QM closing neckline break after head')
    expect(not qmQualified(true, na, 10, 20), 'QM wick-only neckline rejected')
    expect(not qmQualified(true, 9, 10, 20), 'QM pre-head break rejected')
    expect(not qmQualified(true, 21, 10, 20), 'QM late break after shoulder rejected')
    expect(not qmQualified(false, 15, 10, 20), 'QM geometry remains mandatory')
    expect(not qmQualified(true, 10, 10, 20), 'QM requires later than head confirmation')
    expect(qmQualified(true, 20, 10, 20), 'QM shoulder confirmation boundary accepted')
    expect(uniqueStructureDirection(true, false) == 1, 'Unique bullish direction')
    expect(uniqueStructureDirection(false, true) == -1, 'Unique bearish direction')
    expect(uniqueStructureDirection(true, true) == 0, 'Conflicting structure directions rejected')
    expect(uniqueStructureDirection(false, false) == 0, 'No break remains neutral')
    expect(structureBreakTime(array.from(10, 20), array.from(15, 25), 20) == 25, 'QM neckline lookup keeps pivot identity')
    expect(na(structureBreakTime(array.from(10, 20), array.from(15, 25), 30)), 'QM unrelated break rejected')
    expect(na(structureBreakTime(array.from(10, 20), array.from(15), 20)), 'Mismatched break history rejected')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == '', 'Candidate passes all independent mandatory checks')
    expect(candidateRejection(false, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Outside research date window', 'Explain candidate rejection 1')
    expect(candidateRejection(true, false, true, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Direction disabled', 'Explain candidate rejection 2')
    expect(candidateRejection(true, true, false, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Missing structural invalidation', 'Explain candidate rejection 3')
    expect(candidateRejection(true, true, true, false, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Insufficient structure targets', 'Explain candidate rejection 4')
    expect(candidateRejection(true, true, true, true, false, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Fibonacci location filter', 'Explain candidate rejection 5')
    expect(candidateRejection(true, true, true, true, true, false, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Premium/discount filter', 'Explain candidate rejection 6')
    expect(candidateRejection(true, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'ATR volatility filter', 'Explain candidate rejection 7')
    expect(candidateRejection(true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, 85, 75) == 'Manual news pause', 'Explain candidate rejection 8')
    expect(candidateRejection(true, true, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, 85, 75) == 'Outside selected session', 'Explain candidate rejection 9')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, false, true, true, true, true, true, true, true, 85, 75) == 'Setup opposes H1 trend', 'Explain candidate rejection 10')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, false, true, true, true, true, true, true, 85, 75) == 'EMA alignment filter', 'Explain candidate rejection 11')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, false, true, true, true, true, true, 85, 75) == 'Stop distance invalid', 'Explain candidate rejection 12')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, false, true, true, true, true, 85, 75) == 'Entry too far from setup', 'Explain candidate rejection 13')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, false, true, true, true, 85, 75) == 'Minimum reward/risk not met', 'Explain candidate rejection 14')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, false, true, true, 85, 75) == 'Invalid Entry/SL/TP order', 'Explain candidate rejection 15')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, false, true, 85, 75) == 'Session plan limit', 'Explain candidate rejection 16')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, false, 85, 75) == 'Signal cooldown', 'Explain candidate rejection 17')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 74, 75) == 'Quality below threshold', 'Score threshold remains mandatory')
    expect(readinessState(1, true, false, false) == 'BUY READY', 'Pending long is ready not confirmed')
    expect(readinessState(-1, true, false, false) == 'SELL READY', 'Pending short is ready not confirmed')
    expect(readinessState(1, false, true, true) == 'BUY CONFIRMED', 'Triggered long confirmed')
    expect(readinessState(-1, false, true, true) == 'SELL CONFIRMED', 'Triggered short confirmed')
    expect(readinessState(1, false, false, false) == 'WAIT', 'No active plan remains WAIT')
    expect(readinessState(0, true, false, false) == 'WAIT', 'Unknown direction cannot become ready')
var table results = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(results, 0, 0, '107 synthetic assertions passed in this TradingView run', text_color=color.white, bgcolor=color.green)
