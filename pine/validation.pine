    expect(candidateRejection(true, true, true, false, true, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Insufficient structure targets', 'Explain candidate rejection 4')
    expect(candidateRejection(true, true, true, true, false, true, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Fibonacci location filter', 'Explain candidate rejection 5')
    expect(candidateRejection(true, true, true, true, true, false, true, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'Premium/discount filter', 'Explain candidate rejection 6')
    expect(candidateRejection(true, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, 85, 75) == 'ATR volatility filter', 'Explain candidate rejection 7')
    expect(candidateRejection(true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, 85, 75) == 'Manual news pause', 'Explain candidate rejection 8')
    expect(candidateRejection(true, true, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, 85, 75) == 'Outside selected session', 'Explain candidate rejection 9')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, false, true, true, true, true, true, true, true, 85, 75) == 'Setup opposes H1 trend', 'Explain candidate rejection 10')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, false, true, true, true, true, true, true, 85, 75) == 'EMA alignment filter', 'Explain candidate rejection 11')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, false, true, true, true, true, true, 85, 75) == 'Stop distance invalid', 'Explain candidate rejection 12')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, false, true, true, true, true, 85, 75) == 'Entry too far from setup', 'Explain candidate rejection 13')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, false, true, true, true, 85, 75) == 'Minimum reward/risk not met', 'Explain candidate rejection 14')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, false, true, true, 85, 75) == 'Invalid Entry/SL/TP order', 'Explain candidate rejection 15')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, false, true, 85, 75) == 'Session plan limit', 'Explain candidate rejection 16')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, false, 85, 75) == 'Signal cooldown', 'Explain candidate rejection 17')
    expect(candidateRejection(true, true, true, true, true, true, true, false, true, true, true, true, true, true, true, true, true, 74, 75) == 'Quality below threshold', 'Score threshold remains mandatory')
    expect(readinessState(1, true, false, false) == 'BUY READY', 'Pending long is ready not confirmed')
    expect(readinessState(-1, true, false, false) == 'SELL READY', 'Pending short is ready not confirmed')
    expect(readinessState(1, false, true, true) == 'BUY CONFIRMED', 'Triggered long confirmed')
    expect(readinessState(-1, false, true, true) == 'SELL CONFIRMED', 'Triggered short confirmed')
    expect(readinessState(1, false, false, false) == 'WAIT', 'No active plan remains WAIT')
    expect(readinessState(0, true, false, false) == 'WAIT', 'Unknown direction cannot become ready')
    testTerminalLifecycle('A_SWEEP_MSS_FVG', 1, 1100)
    testTerminalLifecycle('B_CRT', -1, 1200)
    testTerminalLifecycle('C_TURTLE_SOUP', 1, 1300)
    testTerminalLifecycle('D_SNR', -1, 1400)
    testTerminalLifecycle('E_DEMAND', 1, 1500)
    testTerminalLifecycle('E_SUPPLY', -1, 1600)
    testTerminalLifecycle('F_TREND_PULLBACK', 1, 1700)
    testTerminalLifecycle('G_AMD', -1, 1800)
    testTerminalLifecycle('H_QUASIMODO', 1, 1900)
    // Lifecycle cases below instantiate the same Candidate type/methods used by production modules.
    Candidate fixtureA = Candidate.new(id='A_SWEEP_MSS_FVG', enabled=true)
    bool detectA = swingSweep(1, 100, 110, 103, 99, 101, true) and breakConfirmed(1, 102, 102, 103) and fairValueGap(1, 106, 105, 104, 109)
    expect(detectA, 'A setup fixture has sweep, later MSS, and FVG evidence')
    if detectA
        fixtureA.begin(100, 1000, 1, 100, 102, 95, 102, 20, 20, 'A retest')
    fixtureA.confirmRetest(100, 1000, 103, 101, 102, 103)
    expect(not fixtureA.ready, 'A cannot confirm on its setup bar')
    fixtureA.maintain(101, 101, 103, 20)
    fixtureA.confirmRetest(101, 2000, 103, 101, 103, 102)
    expect(not fixtureA.ready, 'A opposite-close retest is not confirmed')
    fixtureA.maintain(102, 101, 103, 20)
    fixtureA.confirmRetest(102, 3000, 103, 101, 102, 103)
    expect(fixtureA.ready and fixtureA.readyBar == 102 and fixtureA.confirmationTime == 3000, 'A later retest confirms on knowledge bar')

    Candidate fixtureB = Candidate.new(id='B_CRT', enabled=true)
    bool detectB = referenceUnused(2000, na) and rangeSweep(1, 100, 110, 106, 99, 103)
    expect(detectB, 'B valid reference-candle sweep and reclaim')
    if detectB
        fixtureB.begin(200, 1000, 1, 100, 110, 95, 105, 10, 20, 'B reference sweep')
    fixtureB.confirmBreak(200, 1000, 105, 106)
    expect(not fixtureB.ready, 'B cannot confirm on its setup bar')
    fixtureB.maintain(201, 100, 110, 20)
    fixtureB.confirmBreak(201, 2000, 106, 104)
    expect(not fixtureB.ready, 'B opposite-direction candle does not confirm')
    fixtureB.maintain(202, 100, 110, 20)
    fixtureB.confirmBreak(202, 3000, 105, 106)
    expect(fixtureB.ready and fixtureB.readyBar == 202, 'B later confirmation bar recorded')

    Candidate fixtureC = Candidate.new(id='C_TURTLE_SOUP', enabled=true)
    bool detectC = pivotAgeAvailable(30, 20, 3, na) and pivotSweep(-1, 110, 111, 106, 108)
    expect(detectC, 'C valid bearish confirmed-pivot false breakout')
    if detectC
        fixtureC.begin(300, 1000, -1, 100, 110, 115, 105, 10, 20, 'C false breakout')
    fixtureC.confirmBreak(300, 1000, 105, 104)
    expect(not fixtureC.ready, 'C cannot confirm on its setup bar')
    fixtureC.maintain(301, 100, 110, 20)
    fixtureC.confirmBreak(301, 2000, 104, 106)
    expect(not fixtureC.ready, 'C opposite-direction candle does not confirm')
    fixtureC.maintain(302, 100, 110, 20)
    fixtureC.confirmBreak(302, 3000, 105, 104)
    expect(fixtureC.ready and fixtureC.direction == -1, 'C later bearish confirmation')

    Candidate fixtureD = Candidate.new(id='D_SNR', enabled=true)
    bool detectD = snrRejection(1, 100, 1, 2, 102, 99, 100, 102)
    expect(detectD, 'D valid confirmed support rejection')
    if detectD
        fixtureD.begin(400, 1000, 1, 99, 101, 95, 99, 20, 0, 'D support retest')
    fixtureD.confirmBreak(400, 1000, 99, 102)
    expect(not fixtureD.ready, 'D cannot confirm on its setup bar')
    fixtureD.maintain(401, 100, 102, 20)
    fixtureD.confirmBreak(401, 2000, 102, 98)
    expect(not fixtureD.ready, 'D failed direction close does not confirm')
    fixtureD.maintain(402, 100, 102, 20)
    fixtureD.confirmBreak(402, 3000, 99, 102)
    expect(fixtureD.ready and fixtureD.readyBar == 402, 'D later rejection confirmation')

    Candidate fixtureE = Candidate.new(id='E_DEMAND', enabled=true)
    bool detectE = zoneDeparture(1, 105, 101, 103, 102, 107, true)
    expect(detectE, 'E valid demand departure through confirmed swing')
    if detectE
        fixtureE.begin(500, 1000, 1, 100, 102, 98, 102, 20, 0, 'E demand retest')
    fixtureE.confirmRetest(500, 1000, 103, 101, 102, 103)
    expect(not fixtureE.ready, 'E cannot confirm on its zone-departure bar')
    fixtureE.maintain(501, 101, 103, 20)
    fixtureE.confirmRetest(501, 2000, 103, 101, 103, 102)
    expect(not fixtureE.ready, 'E weak opposite-close zone test does not confirm')
    fixtureE.maintain(502, 101, 103, 20)
    fixtureE.confirmRetest(502, 3000, 103, 101, 102, 103)
    expect(fixtureE.ready and fixtureE.direction == 1, 'E demand later retest confirmation')

    Candidate fixtureF = Candidate.new(id='F_TREND_PULLBACK', enabled=true)
    bool detectF = trendStillValid(1, true, false) and trendPullback(1, true, 105, 103, 108, 104, 106, 2, 0.3)
    expect(detectF, 'F valid structured trend pullback')
    if detectF
        fixtureF.begin(600, 1000, 1, 100, 102, 95, 105, 20, 0, 'F trend pullback')
    fixtureF.confirmBreak(600, 1000, 105, 106)
    expect(not fixtureF.ready, 'F cannot confirm on its pullback bar')
    fixtureF.maintain(601, 100, 110, 20)
    fixtureF.confirmBreak(601, 2000, 106, 104)
    expect(not fixtureF.ready, 'F opposite-direction candle does not confirm')
    fixtureF.maintain(602, 100, 110, 20)
    fixtureF.confirmBreak(602, 3000, 105, 106)
    expect(fixtureF.ready and fixtureF.readyBar == 602, 'F later pullback trigger')

    Candidate fixtureG = Candidate.new(id='G_AMD', enabled=true)
    bool detectG = amdCooldownElapsed(30, na, 12) and compressedRange(106, 100, 2, 3) and rangeSweep(-1, 100, 106, 107, 99, 105)
    expect(detectG, 'G valid compressed-range sweep and reclaim')
    if detectG
        fixtureG.begin(700, 1000, -1, 100, 110, 115, 100, 20, 20, 'G range sweep')
    fixtureG.confirmBreak(700, 1000, 100, 99)
    expect(not fixtureG.ready, 'G cannot continue on its sweep bar')
    fixtureG.maintain(701, 100, 110, 20)
    fixtureG.confirmBreak(701, 2000, 99, 101)
    expect(not fixtureG.ready, 'G opposite-direction candle does not confirm')
    fixtureG.maintain(702, 100, 110, 20)
    fixtureG.confirmBreak(702, 3000, 100, 99)
    expect(fixtureG.ready and fixtureG.direction == -1, 'G later bearish continuation confirmation')

    Candidate fixtureH = Candidate.new(id='H_QUASIMODO', enabled=true)
    bool detectH = qmPattern(-1, 1, 110, 100, 115, 98, 109, 106) and qmQualified(true, 15, 10, 20)
    expect(detectH, 'H valid five-pivot structure and later neckline break')
    if detectH
        fixtureH.begin(800, 1000, -1, 99, 101, 110, 99, 20, 20, 'H neckline retest')
    fixtureH.confirmRetest(800, 1000, 100, 98, 100, 98)
    expect(not fixtureH.ready, 'H cannot confirm on its pivot bar')
    fixtureH.maintain(801, 98, 100, 20)
    fixtureH.confirmRetest(801, 2000, 100, 98, 98, 100)
    expect(not fixtureH.ready, 'H opposite-close retest does not confirm')
    fixtureH.maintain(802, 98, 100, 20)
    fixtureH.confirmRetest(802, 3000, 100, 98, 100, 98)
    expect(fixtureH.ready and fixtureH.readyBar == 802, 'H later retest confirmation')

    Candidate rejectedA = Candidate.new(id='A_REJECTED', enabled=true)
    bool rejectA = swingSweep(1, 100, 110, 103, 100, 101, true) and breakConfirmed(1, 102, 102, 103) and fairValueGap(1, 106, 104, 104, 109)
    if rejectA
        rejectedA.begin(850, 1000, 1, 100, 102, 95, 102, 20, 20, 'Invalid A fixture')
    expect(not rejectA and rejectedA.stage == 0, 'A missing sweep/FVG evidence cannot start candidate')

    Candidate rejectedB = Candidate.new(id='B_REJECTED', enabled=true)
    bool rejectB = referenceUnused(2000, na) and rangeSweep(1, 100, 110, 106, 99, 99.5)
    if rejectB
        rejectedB.begin(851, 1000, 1, 100, 110, 95, 105, 10, 20, 'Invalid B fixture')
    expect(not rejectB and rejectedB.stage == 0, 'B sweep without reclaim cannot start candidate')

    Candidate rejectedC = Candidate.new(id='C_REJECTED', enabled=true)
    bool rejectC = pivotAgeAvailable(30, 20, 3, na) and pivotSweep(-1, 110, 110, 106, 108)
    if rejectC
        rejectedC.begin(852, 1000, -1, 100, 110, 115, 105, 10, 20, 'Invalid C fixture')
    expect(not rejectC and rejectedC.stage == 0, 'C non-swept pivot cannot start candidate')

    Candidate rejectedD = Candidate.new(id='D_REJECTED', enabled=true)
    bool rejectD = snrRejection(1, 100, 1, 1, 102, 99, 100, 102)
    if rejectD
        rejectedD.begin(853, 1000, 1, 99, 101, 95, 99, 20, 0, 'Invalid D fixture')
    expect(not rejectD and rejectedD.stage == 0, 'D one pivot touch cannot qualify confirmed level')

    Candidate rejectedE = Candidate.new(id='E_REJECTED', enabled=true)
    bool rejectE = zoneDeparture(1, 105, 101, 103, 102, 107, false)
    if rejectE
        rejectedE.begin(854, 1000, 1, 100, 102, 98, 102, 20, 0, 'Invalid E fixture')
    expect(not rejectE and rejectedE.stage == 0, 'E non-displaced candle cannot create zone candidate')

    Candidate rejectedF = Candidate.new(id='F_REJECTED', enabled=true)
    bool rejectF = trendStillValid(1, false, true) and trendPullback(1, false, 105, 103, 108, 104, 106, 2, 0.3)
    if rejectF
        rejectedF.begin(855, 1000, 1, 100, 102, 95, 105, 20, 0, 'Invalid F fixture')
    expect(not rejectF and rejectedF.stage == 0, 'F pullback without structural trend cannot start candidate')

    Candidate rejectedG = Candidate.new(id='G_REJECTED', enabled=true)
    bool rejectG = amdCooldownElapsed(30, na, 12) and compressedRange(107, 100, 2, 3) and rangeSweep(-1, 100, 107, 108, 99, 105)
    if rejectG
        rejectedG.begin(856, 1000, -1, 100, 107, 115, 100, 20, 20, 'Invalid G fixture')
    expect(not rejectG and rejectedG.stage == 0, 'G over-wide range cannot create AMD candidate')

    Candidate rejectedH = Candidate.new(id='H_REJECTED', enabled=true)
    bool rejectH = qmPattern(-1, 1, 110, 100, 109, 98, 108, 106) and qmQualified(true, 15, 10, 20)
    if rejectH
        rejectedH.begin(857, 1000, -1, 99, 101, 110, 99, 20, 20, 'Invalid H fixture')
    expect(not rejectH and rejectedH.stage == 0, 'H invalid pivot geometry cannot create candidate')

    Candidate fixtureInvalid = Candidate.new(id='INVALIDATION', enabled=true)
    fixtureInvalid.begin(900, 1000, 1, 100, 102, 98, 102, 20, 20, 'Invalidation fixture')
    fixtureInvalid.maintain(901, 97, 102, 20)
    expect(fixtureInvalid.stage == 0 and fixtureInvalid.status == 'INVALIDATED', 'Candidate invalidates before confirmation')

    Candidate fixtureExpired = Candidate.new(id='EXPIRY', enabled=true)
    fixtureExpired.begin(1000, 1000, -1, 100, 102, 110, 100, 20, 20, 'Expiry fixture')
    fixtureExpired.maintain(1003, 100, 105, 2)
    expect(fixtureExpired.stage == 0 and fixtureExpired.status == 'EXPIRED', 'Candidate expires after configured age')
var table results = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(results, 0, 0, '200 synthetic assertions passed in this TradingView run', text_color=color.white, bgcolor=color.green)
