// Shared candidate lifecycle. Inputs are explicit so fixtures can exercise this exact production code.
type Candidate
    string id = ''
    bool enabled = false
    int stage = 0
    int direction = 0
    int setupBar = na
    int setupTime = na
    int confirmationTime = na
    int readyBar = na
    float trigger = na
    float upper = na
    float lower = na
    float invalidation = na
    int structurePoints = 0
    int liquidityPoints = 0
    int tests = 0
    string status = 'IDLE'
    bool ready = false
    string mode = ''
    string entryMode = ''
    string targetSource = ''
    float plannedEntry = na
    float suggestedStop = na
    float target1 = na
    float target2 = na
    float target3 = na
    int quality = 0
    string rejectionReason = 'Waiting for entry confirmation'

method begin(Candidate c, int currentBar, int currentTime, int direction, float lower, float upper, float invalidation, float trigger, int structurePoints, int liquidityPoints, string mode) =>
    c.stage := 1
    c.direction := direction
    c.setupBar := currentBar
    c.setupTime := currentTime
    c.confirmationTime := na
    c.readyBar := na
    c.lower := lower
    c.upper := upper
    c.invalidation := invalidation
    c.trigger := trigger
    c.structurePoints := structurePoints
    c.liquidityPoints := liquidityPoints
    c.tests := 0
    c.ready := false
    c.status := 'WAITING_CONFIRMATION'
    c.mode := mode
    c.targetSource := ''
    c.plannedEntry := na
    c.suggestedStop := na
    c.target1 := na
    c.target2 := na
    c.target3 := na
    c.quality := 0
    c.rejectionReason := 'Waiting for entry confirmation'

method maintain(Candidate c, int currentBar, float currentLow, float currentHigh, int maxAge) =>
    c.ready := false
    if c.stage > 0
        bool invalid = c.direction == 1 ? currentLow < c.invalidation : currentHigh > c.invalidation
        if invalid or currentBar - c.setupBar > maxAge or not c.enabled
            c.stage := 0
            c.status := invalid ? 'INVALIDATED' : 'EXPIRED'

method confirmBreak(Candidate c, int currentBar, int currentTime, float currentOpen, float currentClose) =>
    if c.stage > 0 and currentBar > c.setupBar
        bool confirmed = breakConfirmed(c.direction, c.trigger, currentOpen, currentClose)
        if confirmed
            c.ready := true
            c.readyBar := currentBar
            c.confirmationTime := currentTime
            c.status := 'WAITING_CONFIRMATION'

method confirmRetest(Candidate c, int currentBar, int currentTime, float currentHigh, float currentLow, float currentOpen, float currentClose) =>
    if c.stage > 0 and currentBar > c.setupBar
        if retestConfirmed(c.direction, c.lower, c.upper, currentHigh, currentLow, currentOpen, currentClose)
            c.ready := true
            c.readyBar := currentBar
            c.confirmationTime := currentTime
            c.status := 'WAITING_CONFIRMATION'

// Independent, persistent candidates. All mutation happens inside confirmed-bar scope.
var Candidate candA = Candidate.new(id='A_SWEEP_MSS_FVG', enabled=enableA)
var Candidate candB = Candidate.new(id='B_CRT', enabled=enableB)
var Candidate candC = Candidate.new(id='C_TURTLE_SOUP', enabled=enableC)
var Candidate candD = Candidate.new(id='D_SNR', enabled=enableD)
var Candidate candDemand = Candidate.new(id='E_DEMAND', enabled=enableE)
var Candidate candSupply = Candidate.new(id='E_SUPPLY', enabled=enableE)
var Candidate candF = Candidate.new(id='F_TREND_PULLBACK', enabled=enableF)
var Candidate candG = Candidate.new(id='G_AMD', enabled=enableG)
var Candidate candH = Candidate.new(id='H_QUASIMODO', enabled=enableH)
var array<Candidate> candidates = array.from(candA, candB, candC, candD, candDemand, candSupply, candF, candG, candH)
var float srHigh = na
var float srLow = na
var int srHighTouches = 0
var int srLowTouches = 0
var array<int> pivotDirs = array.new<int>()
var array<float> pivotPrices = array.new<float>()
var array<int> pivotTimes = array.new<int>()

// Requests are top-level: confirmed source candles only, never synthetic lower-TF entries.
[crtHigh, crtLow, crtTime] = request.security(syminfo.tickerid, crtTF, [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)
accHigh = ta.highest(high[1], accumulationBars)
accLow = ta.lowest(low[1], accumulationBars)
ema50 = ta.ema(close, 50)
bodyDisplacement = math.abs(close - open) >= atr * minDisp

type ModuleMemory
    int crtUsed = na
    int turtleUsedLow = na
    int turtleUsedHigh = na
    int demandUsed = na
    int supplyUsed = na
    int amdUsed = na
    int qmUsed = na
var ModuleMemory memory = ModuleMemory.new()
// Context is always calculated; optional overlays never become mandatory strategy votes.
[pdh, pdl] = request.security(syminfo.tickerid, 'D', [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, 'W', [high[1], low[1]], lookahead=barmerge.lookahead_on)
var float sessionHigh = na
var float sessionLow = na
var float previousSessionHigh = na
var float previousSessionLow = na
var float bullOBLow = na
var float bullOBHigh = na
var float bearOBLow = na
var float bearOBHigh = na
var float bullBreaker = na
var float bearBreaker = na
var float equalHigh = na
var float equalLow = na
var bool bullSpring = false
var bool bearUpthrust = false
var float managedStop = na
var float filledEntry = na
var int fillBar = na
var float initialQty = na
var string targetSource = 'Fixed R projection'
var string signalTrend = 'Unknown'
var int signalSetupTime = na
var float signalInvalidation = na
var float signalPrice = na

getTargets(int direction, float planned, float risk) =>
    array<float> known = array.from(sh, slw, srHigh, srLow, pdh, pdl, pwh, pwl, previousSessionHigh, previousSessionLow, equalHigh, equalLow)
    if direction == -1 and candDemand.stage > 0
        array.push(known, candDemand.upper)
    if direction == 1 and candSupply.stage > 0
        array.push(known, candSupply.lower)
    array<float> opposing = array.new<float>()
    for level in known
        float rounded = math.round_to_mintick(level)
        if not na(rounded) and direction * (rounded - planned) >= syminfo.mintick * 2 and not array.includes(opposing, rounded)
            array.push(opposing, rounded)
    array.sort(opposing, direction == 1 ? order.ascending : order.descending)
    bool enough = array.size(opposing) >= 3
    bool structural = targetMode != 'Fixed R' and enough
    float targetOne = structural ? array.get(opposing, 0) : math.round_to_mintick(planned + direction * risk * r1)
    float targetTwo = structural ? array.get(opposing, 1) : math.round_to_mintick(planned + direction * risk * r2)
    float targetThree = structural ? array.get(opposing, 2) : math.round_to_mintick(planned + direction * risk * r3)
    string source = structural ? 'Confirmed structure' : targetMode == 'Hybrid' ? 'Hybrid: fixed-R fallback' : 'Fixed R projection'
    bool available = targetMode != 'Structure' or enough
    [targetOne, targetTwo, targetThree, source, available]

optionalLiquidity(int direction) =>
    bool equalSweep = direction == 1 ? not na(equalLow) and low < equalLow and close > equalLow : not na(equalHigh) and high > equalHigh and close < equalHigh
    bool daySweep = direction == 1 ? low < pdl and close > pdl : high > pdh and close < pdh
    bool weekSweep = direction == 1 ? low < pwl and close > pwl : high > pwh and close < pwh
    bool spring = direction == 1 ? bullSpring : bearUpthrust
    // One liquidity category: never stack points for different names of the same sweep.
    equalSweep or daySweep or weekSweep or spring
// REVIEW_PATTERN_STATE_BEGIN
type ReviewPattern
    int setupTime = na
var ReviewPattern reviewQm = ReviewPattern.new()
var array<int> reviewQmBars = array.new<int>()
var array<float> reviewQmPrices = array.new<float>()
// REVIEW_PATTERN_STATE_END
updateCandidates() =>
    // Called once at chart close. This file is inlined inside the confirmed-bar block.
    for c in candidates
        c.maintain(bar_index, low, high, expiry)

    // A exposes the existing sweep/MSS/FVG state without changing its sequence.
    candA.stage := stage
    candA.direction := dir
    candA.setupBar := setupBar
    candA.setupTime := setupTime
    candA.lower := gapBottom
    candA.upper := gapTop
    candA.invalidation := extreme
    candA.structurePoints := 20
    candA.liquidityPoints := 20
    candA.status := status
    candA.ready := enableA and stage == 2 and bar_index > gapBar and retestConfirmed(dir, gapBottom, gapTop, high, low, open, close)

    bool idleForSetup = not active and not pending and not brokerBusy
    if idleForSetup
        // B: previous completed reference candle; frozen sweep -> later break of sweep candle.
        candB.confirmBreak(bar_index, time_close, open, close)
        if enableB and candB.stage == 0 and referenceUnused(crtTime, memory.crtUsed)
            bool bull = rangeSweep(1, crtLow, crtHigh, high, low, close)
            bool bear = rangeSweep(-1, crtLow, crtHigh, high, low, close)
            if bull != bear
                candB.begin(bar_index, time_close, bull ? 1 : -1, crtLow, crtHigh, bull ? low : high, bull ? high : low, 10, 20, 'Reference sweep')
                memory.crtUsed := crtTime

        // C: confirmed-pivot false breakout, not the original 20-day Turtle Soup variant.
        candC.confirmBreak(bar_index, time_close, open, close)
        if enableC and candC.stage == 0
            bool bull = not na(slw) and pivotAgeAvailable(bar_index, slBar, turtleAge, memory.turtleUsedLow) and pivotSweep(1, slw, high, low, close)
            bool bear = not na(sh) and pivotAgeAvailable(bar_index, shBar, turtleAge, memory.turtleUsedHigh) and pivotSweep(-1, sh, high, low, close)
            if bull != bear
                candC.begin(bar_index, time_close, bull ? 1 : -1, bull ? slw : low, bull ? high : sh, bull ? low : high, bull ? high : low, 10, 20, 'Pivot false breakout')
                if bull
                    memory.turtleUsedLow := slBar
                else
                    memory.turtleUsedHigh := shBar

        // D: repeated confirmed horizontal pivots; displaced breakout/retest or failed breakout/rejection.
        if candD.mode == 'Breakout retest'
            candD.confirmRetest(bar_index, time_close, high, low, open, close)
        else
            candD.confirmBreak(bar_index, time_close, open, close)
        if enableD and candD.stage == 0
            float tolerance = atr * levelTolerance
            bool up = snrBreakout(1, srHigh, tolerance, srHighTouches, close[1], open, close, bodyDisplacement)
            bool down = snrBreakout(-1, srLow, tolerance, srLowTouches, close[1], open, close, bodyDisplacement)
            bool rejectLow = snrRejection(1, srLow, tolerance, srLowTouches, high, low, open, close)
            bool rejectHigh = snrRejection(-1, srHigh, tolerance, srHighTouches, high, low, open, close)
            if up != down and (up or down)
                float level = up ? srHigh : srLow
                candD.begin(bar_index, time_close, up ? 1 : -1, level - tolerance, level + tolerance, up ? math.min(low, level - tolerance) : math.max(high, level + tolerance), level, 20, 0, 'Breakout retest')
            else if rejectLow != rejectHigh
                float level = rejectLow ? srLow : srHigh
                bool swept = rejectLow ? low < srLow - tolerance : high > srHigh + tolerance
                candD.begin(bar_index, time_close, rejectLow ? 1 : -1, level - tolerance, level + tolerance, rejectLow ? low : high, rejectLow ? high : low, 20, swept ? 20 : 0, swept ? 'Failed breakout' : 'Rejection')

        // E: opposite-candle zone followed by impulsive break of a known confirmed swing.
        // Existing zones are processed before creating replacements; tested bars are counted explicitly.
        for c in array.from(candDemand, candSupply)
            if c.stage > 0 and bar_index > c.setupBar
                bool touch = high >= c.lower and low <= c.upper
                bool withinTestLimit = zoneTestsWithinLimit(c.tests, touch, maxZoneTests)
                if touch
                    c.tests += 1
                    c.status := c.tests == 1 ? 'FRESH_TEST' : 'TESTED'
                if not withinTestLimit
                    c.stage := 0
                    c.status := 'EXPIRED'
                else
                    c.confirmRetest(bar_index, time_close, high, low, open, close)
        bool demandDeparture = not na(sh) and zoneDeparture(1, sh, close[1], open[1], open, close, bodyDisplacement)
        bool supplyDeparture = not na(slw) and zoneDeparture(-1, slw, close[1], open[1], open, close, bodyDisplacement)
        if enableE and candDemand.stage == 0 and demandDeparture and (na(memory.demandUsed) or memory.demandUsed != time[1])
            candDemand.begin(bar_index, time_close, 1, low[1], high[1], low[1], high[1], 20, 0, 'Demand departure')
            memory.demandUsed := time[1]
        if enableE and candSupply.stage == 0 and supplyDeparture and (na(memory.supplyUsed) or memory.supplyUsed != time[1])
            candSupply.begin(bar_index, time_close, -1, low[1], high[1], high[1], low[1], 20, 0, 'Supply departure')
            memory.supplyUsed := time[1]

        // F: structural trend + pullback into EMA9/21 band, then later rejection of frozen pullback high/low.
        candF.confirmBreak(bar_index, time_close, open, close)
        bool bullTrend = chartStructure == 1 and ema9 > ema21 and (not useEMA50 or ema21 > ema50)
        bool bearTrend = chartStructure == -1 and ema9 < ema21 and (not useEMA50 or ema21 < ema50)
        if candF.stage > 0 and not trendStillValid(candF.direction, bullTrend, bearTrend)
            candF.stage := 0
            candF.ready := false
            candF.status := 'INVALIDATED'
        if enableF and candF.stage == 0
            bool bull = trendPullback(1, bullTrend, ema9, ema21, high, low, close, atr, pullbackDepth)
            bool bear = trendPullback(-1, bearTrend, ema9, ema21, high, low, close, atr, pullbackDepth)
            if bull != bear
                candF.begin(bar_index, time_close, bull ? 1 : -1, math.min(ema9, ema21), math.max(ema9, ema21), bull ? math.min(low, slw) : math.max(high, sh), bull ? high : low, 20, 0, 'EMA structural pullback')

        // G: compressed prior rolling range -> sweep/reclaim -> later displacement out of frozen range.
        candG.confirmBreak(bar_index, time_close, open, close)
        if candG.ready and not bodyDisplacement
            candG.ready := false
        if enableG and candG.stage == 0 and compressedRange(accHigh, accLow, atr, accumulationWidth) and amdCooldownElapsed(bar_index, memory.amdUsed, accumulationBars)
            bool bull = rangeSweep(1, accLow, accHigh, high, low, close)
            bool bear = rangeSweep(-1, accLow, accHigh, high, low, close)
            if bull != bear
                candG.begin(bar_index, time_close, bull ? 1 : -1, accLow, accHigh, bull ? low : high, bull ? accHigh : accLow, 20, 20, 'Compression sweep')
                memory.amdUsed := bar_index

        // H: five alternating confirmed pivots form shoulder/head/neckline break, then level retest.
        candH.confirmRetest(bar_index, time_close, high, low, open, close)
        if enableH and candH.stage == 0 and array.size(pivotPrices) == 5
            float p0 = array.get(pivotPrices, 0)
            float p1 = array.get(pivotPrices, 1)
            float p2 = array.get(pivotPrices, 2)
            float p3 = array.get(pivotPrices, 3)
            float p4 = array.get(pivotPrices, 4)
            int patternKey = array.get(pivotTimes, 4)
            int necklinePivot = array.get(pivotTimes, 1)
            int headConfirmed = array.get(pivotTimes, 2)
            int shoulderConfirmed = array.get(pivotTimes, 4)
            int bullNecklineBar = structureBreakTime(bullBreakPivots, bullBreakBars, necklinePivot)
            int bearNecklineBar = structureBreakTime(bearBreakPivots, bearBreakBars, necklinePivot)
            bool bull = qmQualified(qmPattern(1, array.get(pivotDirs, 0), p0, p1, p2, p3, p4, close), bullNecklineBar, headConfirmed, shoulderConfirmed)
            bool bear = qmQualified(qmPattern(-1, array.get(pivotDirs, 0), p0, p1, p2, p3, p4, close), bearNecklineBar, headConfirmed, shoulderConfirmed)
            if (bull != bear) and (na(memory.qmUsed) or memory.qmUsed != patternKey)
                float tolerance = atr * levelTolerance
                candH.begin(bar_index, time_close, bull ? 1 : -1, p0 - tolerance, p0 + tolerance, p2, p0, 20, 20, 'Confirmed 5-pivot QM')
                // REVIEW_PATTERN_CAPTURE_BEGIN
                array.clear(reviewQmBars)
                array.clear(reviewQmPrices)
                for reviewIndex = 0 to 4
                    array.push(reviewQmBars, array.get(pivotTimes, reviewIndex))
                    array.push(reviewQmPrices, array.get(pivotPrices, reviewIndex))
                reviewQm.setupTime := candH.setupTime
                // REVIEW_PATTERN_CAPTURE_END
                memory.qmUsed := patternKey
    0
strategyName(string id) =>
    str.startswith(id, 'A_') ? 'A · Sweep + reversal + gap' : str.startswith(id, 'B_') ? 'B · Candle range reversal' : str.startswith(id, 'C_') ? 'C · False breakout reversal' : str.startswith(id, 'D_') ? 'D · K-SNR' : str.startswith(id, 'E_') ? 'E · Supply / demand' : str.startswith(id, 'F_') ? 'F · Trend pullback' : str.startswith(id, 'G_') ? 'G · Range sweep continuation' : str.startswith(id, 'H_') ? 'H · Quasimodo retest' : 'No strategy selected'
setupExplanation(string id) =>
    str.startswith(id, 'A_') ? 'Sweep reclaimed; MSS + FVG; later retest confirmed' : str.startswith(id, 'B_') ? 'Completed range reclaimed; later reversal close' : str.startswith(id, 'C_') ? 'Confirmed-pivot false breakout; reversal close' : str.startswith(id, 'D_') ? 'Confirmed K-SNR level; retest/rejection trigger' : str.startswith(id, 'E_') ? 'Impulsive departure; zone retest confirmed' : str.startswith(id, 'F_') ? 'Structure + EMA pullback; later trigger close' : str.startswith(id, 'G_') ? 'Compressed range swept; later displacement' : 'Five confirmed pivots; closing neckline break; later retest'
statusName(string raw) =>
    raw == 'IDLE' ? 'Waiting for a setup' : raw == 'DETECTED' ? 'Setup found · not an entry' : raw == 'WAITING_CONFIRMATION' ? 'Waiting for confirmation' : raw == 'CONFIRMED' ? 'Setup confirmed' : raw == 'ENTRY_PENDING' ? 'Order pending · not filled' : raw == 'ENTRY_TRIGGERED' ? 'Entry triggered (simulated)' : raw == 'CLOSED' ? 'Previous trade closed' : raw == 'EXPIRED' ? 'Setup expired' : raw == 'INVALIDATED' ? 'Setup no longer valid' : raw == 'EXPIRED / INVALIDATED' ? 'Setup expired / invalid' : raw == 'INVALIDATED FVG' ? 'Price gap invalidated' : str.startswith(raw, 'REJECTED') ? 'Rejected: ' + str.lower(str.replace_all(raw, 'REJECTED: ', '')) : str.replace_all(raw, '_', ' ')
priceText(float value) => na(value) ? '—' : str.tostring(value, format.mintick)
var array<label> structureTags = array.new<label>()
var array<string> structureKinds = array.new<string>()
structureTag(float price, string caption, color background) =>
    string kind = str.contains(caption, 'SWEEP') ? (str.contains(caption, 'HIGH') ? 'sweep-high' : 'sweep-low') : (str.contains(caption, 'BOS') or str.contains(caption, 'CHoCH') or str.contains(caption, 'MSS') ? 'structure' : 'swing')
    if contextHistory == 'Latest only' and array.size(structureTags) > 0
        for i = array.size(structureTags) - 1 to 0
            if array.get(structureKinds, i) == kind
                label.delete(array.remove(structureTags, i))
                array.remove(structureKinds, i)
    bool above = str.contains(caption, 'Bullish') ? false : str.contains(caption, 'Bearish') ? true : price >= close
    float offset = atr * (0.5 + 0.35 * (bar_index % 3))
    float labelPrice = above ? math.max(price, high) + offset : math.min(price, low) - offset
    label tag = label.new(bar_index, labelPrice, caption, style=above ? label.style_label_down : label.style_label_up, color=color.new(background, contextTransparency), textcolor=panelValue, size=chartText)
    array.push(structureTags, tag)
    array.push(structureKinds, kind)
    if array.size(structureTags) > maxStructureLabels
        label.delete(array.shift(structureTags))
        array.shift(structureKinds)
    tag
roundPrice(float p) => math.round_to_mintick(p)
jsonEscape(string s) => str.replace_all(str.replace_all(str.replace_all(s, '\\', '\\\\'), '"', '\\"'), '\n', ' ')
// REVIEW_OUTCOME_HELPER_BEGIN — presentation and closure metadata only.
reviewCloseCode(bool stopped, bool finalTarget, bool timed) =>
    stopped ? 'STOP' : finalTarget ? 'TP3' : timed ? 'TIME_EXIT' : 'CLOSED_OTHER'
reviewExitCode(string comment, bool timeOrder) =>
    comment == 'STOP_LOSS_HIT' ? 'STOP' : comment == 'TP1_HIT' ? 'TP1' : comment == 'TP2_HIT' ? 'TP2' : comment == 'TP3_HIT' ? 'TP3' : timeOrder ? 'TIME_EXIT' : 'CLOSED_OTHER'
reviewCloseCaption(string code, bool broker) =>
    string caption = code == 'STOP' ? 'SL exit' : code == 'TIME_EXIT' ? 'Time exit' : code == 'TP1' ? 'TP1 exit' : code == 'TP2' ? 'TP2 exit' : code == 'TP3' ? 'TP3 exit' : 'Closed'
    caption + (broker ? ' (sim.)' : ' (est.)')
reviewModuleName(string id) =>
    str.startswith(id, 'A_') ? 'A Sweep/MSS/FVG' : str.startswith(id, 'B_') ? 'B CRT' : str.startswith(id, 'C_') ? 'C Pivot false break' : str.startswith(id, 'D_') ? 'D K-SNR' : str.startswith(id, 'E_') ? 'E Supply/demand' : str.startswith(id, 'F_') ? 'F Trend pullback' : str.startswith(id, 'G_') ? 'G AMD range' : str.startswith(id, 'H_') ? 'H Quasimodo' : 'No plan'
type ReviewOutcome
    int planTime = na
    int closeTime = na
    string code = ''
    float price = na
    float net = na
    string accountCurrency = ''
var ReviewOutcome reviewOutcome = ReviewOutcome.new()
reviewOutcomeJson(string kind, int planTime) =>
    bool known = kind == 'TRADE_CLOSED' and reviewOutcome.planTime == planTime and not na(reviewOutcome.closeTime)
    string values = known ? ',"closeReason":"' + reviewOutcome.code + '","closedAt":' + str.tostring(reviewOutcome.closeTime) : ''
    if known and useBroker and not na(reviewOutcome.price)
        values += ',"exitPrice":' + str.tostring(reviewOutcome.price, format.mintick)
    if known and useBroker and not na(reviewOutcome.net)
        values += ',"realizedNet":' + str.tostring(reviewOutcome.net, '#.########') + ',"realizedCurrency":"' + jsonEscape(reviewOutcome.accountCurrency) + '"'
    values
// REVIEW_OUTCOME_HELPER_END
event(string kind) =>
    string id = syminfo.tickerid + ':' + timeframe.period + ':' + str.tostring(signalTime) + ':' + str.tostring(dir) + ':' + selectedStrategy + ':' + kind
    '{"eventId":"' + jsonEscape(id) + '","eventType":"' + kind + '","symbol":"' + jsonEscape(syminfo.tickerid) + '","timeframe":"' + timeframe.period + '","direction":"' + (dir == 1 ? 'BUY' : 'SELL') + '","strategy":"' + selectedStrategy + '","entry":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(stop, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"reason":"' + jsonEscape(signalReason) + '","setupProgress":"' + jsonEscape(statusName(status)) + '","alignment":"' + signalAlignment + '","scriptVersion":"' + SCRIPT_VERSION + '","quality":' + str.tostring(quality) + ',"timestamp":' + str.tostring(signalTime) + ',"h1Trend":"' + signalTrend + '","targetSource":"' + targetSource + '","setupTimestamp":' + str.tostring(signalSetupTime) + ',"invalidation":' + str.tostring(signalInvalidation, format.mintick) + ',"eventTimestamp":' + str.tostring(time_close) + ',"status":"' + status + '","entryMode":"' + entryMode + '","managedSl":' + str.tostring(managedStop, format.mintick) + ',"signalPrice":' + str.tostring(signalPrice, format.mintick) + ',"executionModel":"' + (useBroker ? 'STRATEGY_EMULATOR' : 'INDICATOR_ESTIMATE') + '","filledEntry":' + (na(filledEntry) ? 'null' : str.tostring(filledEntry, format.mintick)) + reviewOutcomeJson(kind, signalTime) + '}'
notifyEntry(string kind) =>
    string payload = event(kind)
    if auditLog
        log.info(payload)
    alert(payload, alert.freq_once_per_bar_close)
notifyLifecycle(string kind) =>
    string payload = event(kind)
    if auditLog
        log.info(payload)
    alert(payload, alert.freq_all)
// Flags consumed by both the visual indicator and strategy adapter.
bool newSignal = false
bool entryTriggered = false
bool cancelOrder = false
if barstate.isfirst and useResearchWindow and researchEnd <= researchStart
    runtime.error('Research window end must be later than start')
if barstate.isconfirmed
    validationReason := 'Waiting for entry confirmation'
    bullSpring := not na(slw) and low < slw and close > slw and close > open and close > low + (high - low) * 0.65
    bearUpthrust := not na(sh) and high > sh and close < sh and close < open and close < high - (high - low) * 0.65
    if newSession
        previousSessionHigh := sessionHigh
        previousSessionLow := sessionLow
        sessionHigh := high
        sessionLow := low
    else if inSession
        sessionHigh := na(sessionHigh) ? high : math.max(sessionHigh, high)
        sessionLow := na(sessionLow) ? low : math.min(sessionLow, low)
    // Broken OBs become breaker-level heuristics only after a confirmed close through the far boundary.
    if not na(bullOBLow) and close < bullOBLow
        bearBreaker := bullOBLow
        bullOBLow := na
        bullOBHigh := na
    if not na(bearOBHigh) and close > bearOBHigh
        bullBreaker := bearOBHigh
        bearOBHigh := na
        bearOBLow := na
    if bodyDisplacement and close > open and close[1] < open[1] and close > high[1]
        bullOBLow := low[1]
        bullOBHigh := high[1]
    if bodyDisplacement and close < open and close[1] > open[1] and close < low[1]
        bearOBLow := low[1]
        bearOBHigh := high[1]
    if not na(ph) and not na(sh) and math.abs(ph - sh) <= atr * 0.1
        equalHigh := math.round_to_mintick((ph + sh) / 2)
    if not na(pl) and not na(slw) and math.abs(pl - slw) <= atr * 0.1
        equalLow := math.round_to_mintick((pl + slw) / 2)
    // BROKER_SYNC
    if newSession
        sessionTrades := 0
    // Manage existing plans before detecting new ones. Never evaluate fills on signal bar.
    if pending and bar_index > signalBar
        bool invalid = dir == 1 ? low <= stop : high >= stop
        bool expired = bar_index - signalBar > pendingBars
        bool touched = not useBroker and (entryMode == 'Limit' ? (dir == 1 ? low <= entry : high >= entry) : (dir == 1 ? high >= entry : low <= entry))
        if invalid or expired or pause or (useSession and not inSession) or not researchBarAllowed(useResearchWindow, researchStart, researchEnd, time, time_close)
            pending := false
            cancelOrder := true
            status := expired ? 'EXPIRED' : 'INVALIDATED'
            notifyLifecycle('SIGNAL_INVALIDATED')
        else if touched
            pending := false
            active := true
            fillTime := time_close
            fillBar := bar_index
            filledEntry := entryMode == 'Limit' ? (dir == 1 ? math.min(open, entry) : math.max(open, entry)) : (dir == 1 ? math.max(open, entry) : math.min(open, entry))
            entryTriggered := true
            status := 'ENTRY_TRIGGERED'
            notifyEntry(dir == 1 ? 'BUY_SIGNAL' : 'SELL_SIGNAL')
            notifyLifecycle('ENTRY_TRIGGERED')
    if active and not entryTriggered and bar_index > fillBar
        bool stopped = dir == 1 ? low <= managedStop : high >= managedStop
        bool third = dir == 1 ? high >= tp3 : low <= tp3
        bool timed = timeExit > 0 and time_close - fillTime >= timeExit * 60000
        if not useBroker
            // Conservative stop-first convention for indicator-only touch estimates.
            if stopped or third or timed
                status := 'CLOSED'
            if stopped
                notifyLifecycle('STOP_LOSS_HIT')
            else
                if not hit1 and (dir == 1 ? high >= tp1 : low <= tp1)
                    hit1 := true
                    notifyLifecycle('TP1_HIT')
                if not hit2 and (dir == 1 ? high >= tp2 : low <= tp2)
                    hit2 := true
                    notifyLifecycle('TP2_HIT')
                if third
                    notifyLifecycle('TP3_HIT')
            if stopped or third or timed
                active := false
                // REVIEW_ESTIMATE_CAPTURE_BEGIN
                reviewOutcome.planTime := signalTime
                reviewOutcome.closeTime := time_close
                reviewOutcome.code := reviewCloseCode(stopped, third, timed)
                reviewOutcome.price := na
                reviewOutcome.net := na
                reviewOutcome.accountCurrency := ''
                // REVIEW_ESTIMATE_CAPTURE_END
                notifyLifecycle('TRADE_CLOSED')
        if active
            float originalRisk = math.abs(filledEntry - stop)
            float favorableR = originalRisk > 0 ? dir * (close - filledEntry) / originalRisk : 0
            float tightened = managedStop
            if breakEven and favorableR >= breakEvenR
                tightened := tightenStop(dir, tightened, filledEntry)
            if trailing and favorableR >= trailingStartR
                float trailPrice = roundPrice(close - dir * atr * trailingATR)
                tightened := tightenStop(dir, tightened, trailPrice)
            managedStop := roundPrice(tightened)
    if stage > 0 and (bar_index - setupBar > expiry or (dir == 1 ? low < extreme : high > extreme))
        stage := 0
        status := 'EXPIRED / INVALIDATED'
    if stage == 2 and (dir == 1 ? close < gapBottom : close > gapTop)
        stage := 0
        status := 'INVALIDATED FVG'
    updateCandidates()
    // Safety is applied per candidate before deterministic, conflict-aware arbitration.
    Candidate best = na
    int bestScore = -1
    int eligibleDirection = 0
    bool conflict = false
    float bestEntry = na
    float bestStop = na
    float best1 = na
    float best2 = na
    float best3 = na
    string bestTargetSource = ''
    // A cancellation belongs to the old order ID. Do not replace it on this bar.
    if planSlotAvailable(active, pending, brokerBusy, cancelOrder)
        for c in candidates
            if c.enabled and c.ready
                int direction = c.direction
                bool aligned = hTrend == direction
                bool emaOK = direction == 1 ? ema9 > ema21 : ema9 < ema21
                float anchor = (c.upper + c.lower) / 2
                float planned = roundPrice(entryMode == 'Close' ? close : entryMode == 'Limit' ? anchor : direction == 1 ? high + syminfo.mintick : low - syminfo.mintick)
                float baseStop = stopMode == 'Swing' ? (direction == 1 ? slw : sh) : stopMode == 'ATR' ? planned - direction * atr * atrStop : stopMode == 'Order Block' ? (direction == 1 ? bullOBLow : bearOBHigh) : stopMode == 'Sweep extreme' ? (c.liquidityPoints > 0 ? c.invalidation : na) : c.invalidation
                float proposedStop = roundPrice(baseStop - direction * atr * buffer)
                float risk = direction * (planned - proposedStop)
                [t1, t2, t3, source, targetsAvailable] = getTargets(direction, planned, risk)
                bool validTargets = orderedPrices(direction, planned, proposedStop, t1, t2, t3)
                float riskTicks = math.round(risk / syminfo.mintick)
                bool rrOK = rrFeasible(direction, planned, proposedStop, t2, minRR, syminfo.mintick)
                int liquidityScore = confluenceLiquidity and optionalLiquidity(direction) ? math.max(c.liquidityPoints, 20) : c.liquidityPoints
                int score = qualityScore(c.structurePoints, liquidityScore, aligned, rrOK, volOK, inSession)
                int moduleThreshold = str.startswith(c.id, 'A_') ? thresholdA : str.startswith(c.id, 'B_') ? thresholdB : str.startswith(c.id, 'C_') ? thresholdC : str.startswith(c.id, 'D_') ? thresholdD : str.startswith(c.id, 'E_') ? thresholdE : str.startswith(c.id, 'F_') ? thresholdF : str.startswith(c.id, 'G_') ? thresholdG : thresholdH
                float swingRange = sh - slw
                float retracement = swingRange > 0 ? (direction == 1 ? (sh - planned) / swingRange : (planned - slw) / swingRange) : na
                bool fibOK = not confluenceFib or (retracement >= 0.5 and retracement <= 0.618)
                bool pdOK = not confluencePD or (swingRange > 0 and (direction == 1 ? planned <= (sh + slw) / 2 : planned >= (sh + slw) / 2))
                string blocked = candidateRejection(researchBarAllowed(useResearchWindow, researchStart, researchEnd, time, time_close), directionAllowed(tradeSide, direction), not na(c.invalidation) and c.invalidation > 0, targetsAvailable, fibOK, pdOK, volOK, pause, not useSession or inSession, not trendFilter or aligned, not emaFilter or emaOK, riskTicks >= 2 and risk <= atr * maxStop, math.abs(planned - anchor) <= atr * maxDistance, rrOK, validTargets and math.min(proposedStop, t3) > 0, sessionTrades < maxTrades, na(lastSignal) or bar_index - lastSignal >= cooldown, score, strategyThresholds ? moduleThreshold : threshold)
                bool safe = blocked == ''
                c.rejectionReason := blocked
                if blocked != ''
                    validationReason := strategyName(c.id) + ': ' + blocked
                c.targetSource := source
                c.entryMode := entryMode
                c.plannedEntry := planned
                c.suggestedStop := proposedStop
                c.target1 := t1
                c.target2 := t2
                c.target3 := t3
                c.quality := score
                c.confirmationTime := time_close
                if safe and score >= (strategyThresholds ? moduleThreshold : threshold)
                    c.status := 'CONFIRMED'
                    if eligibleDirection != 0 and eligibleDirection != direction
                        conflict := true
                    eligibleDirection := direction
                    if score > bestScore
                        best := c
                        bestScore := score
                        bestEntry := planned
                        bestStop := proposedStop
                        best1 := t1
                        best2 := t2
                        best3 := t3
                        bestTargetSource := source
        if conflict
            status := 'REJECTED: OPPOSING CANDIDATES'
            validationReason := 'Opposing qualified directions; no trade'
        else if not na(best)
            dir := best.direction
            selectedStrategy := best.id
            setupTime := best.setupTime
            entry := bestEntry
            stop := bestStop
            tp1 := best1
            tp2 := best2
            tp3 := best3
            quality := bestScore
            signalAlignment := hTrend == 0 ? 'NEUTRAL' : hTrend == dir ? 'ALIGNED' : 'COUNTER_TREND'
            signalReason := setupExplanation(selectedStrategy) + ' | H1 ' + (signalAlignment == 'ALIGNED' ? 'aligned' : signalAlignment == 'COUNTER_TREND' ? 'counter-trend' : 'neutral') + ' | TP2 ' + str.tostring(math.abs(best2 - bestEntry) / math.abs(bestEntry - bestStop), '#.##') + 'R | Quality ' + str.tostring(bestScore) + '/100'
            managedStop := bestStop
            targetSource := bestTargetSource
            signalTrend := hTrend == 1 ? 'Bullish' : hTrend == -1 ? 'Bearish' : 'Neutral'
            signalSetupTime := best.setupTime
            signalInvalidation := best.invalidation
            signalPrice := close
            filledEntry := not useBroker and entryMode == 'Close' ? entry : na
            fillBar := not useBroker and entryMode == 'Close' ? bar_index : na
            signalTime := time_close
            signalBar := bar_index
            lastSignal := bar_index
            sessionTrades += 1
            totalPlans += 1
            newSignal := true
            hit1 := false
            hit2 := false
            pending := useBroker or entryMode != 'Close'
            active := not pending
            fillTime := active ? time_close : na
            entryTriggered := active
            status := pending ? 'ENTRY_PENDING' : 'ENTRY_TRIGGERED'
            stage := 0
            for c in candidates
                c.stage := 0
                c.ready := false
                c.status := c.id == selectedStrategy ? status : 'IDLE'
            if active
                notifyEntry(dir == 1 ? 'BUY_SIGNAL' : 'SELL_SIGNAL')
                notifyLifecycle('ENTRY_TRIGGERED')
    if enableA and stage == 1 and bar_index > setupBar
        bool mssFvg = mssFvgConfirmed(dir, breakLevel, high, low, high[2], low[2], open, close, atr, minDisp)
        if mssFvg
            gapTop := dir == 1 ? low : low[2]
            gapBottom := dir == 1 ? high[2] : high
            gapBar := bar_index
            stage := 2
            status := 'WAITING_CONFIRMATION'
            if showZones and visualLayout != 'Reference'
                box.delete(fvgBox)
                fvgBox := box.new(bar_index, gapTop, bar_index + expiry, gapBottom, bgcolor=color.new(color.orange, 85), border_color=color.orange, text='Price gap · reversal', text_color=color.rgb(124, 45, 18), text_size=chartText)
            if showOB and visualLayout != 'Reference'
                for offset = 1 to 5
                    bool opposite = dir == 1 ? close[offset] < open[offset] : close[offset] > open[offset]
                    if opposite
                        box.delete(obBox)
                        obBox := box.new(bar_index, high[offset], bar_index + expiry, low[offset], bgcolor=color.new(color.purple, 88), border_color=color.purple, text='Order block (estimated)', text_color=color.rgb(107, 33, 168), text_size=chartText)
                        break
            if showStructure and visualLayout != 'Reference'
                structureTag(close, dir == 1 ? 'Bullish MSS' : 'Bearish MSS', dir == 1 ? color.rgb(44, 153, 124) : color.rgb(220, 73, 83))
    // Use only levels known before this bar; pivots are updated below.
    bool bullSweep = swingSweep(1, slw, sh, high, low, close, na(usedLow) or slBar != usedLow)
    bool bearSweep = swingSweep(-1, sh, slw, high, low, close, na(usedHigh) or shBar != usedHigh)
    if enableA and stage == 0 and not active and not pending and not brokerBusy and bullSweep != bearSweep
        if bullSweep or bearSweep
            dir := bullSweep ? 1 : -1
            extreme := bullSweep ? low : high
            breakLevel := bullSweep ? sh : slw
            setupBar := bar_index
            setupTime := time_close
            stage := 1
            status := 'DETECTED'
            if bullSweep
                usedLow := slBar
            else
                usedHigh := shBar
            if showStructure and visualLayout != 'Reference'
                structureTag(extreme, dir == 1 ? 'LOW LIQUIDITY SWEEP' : 'HIGH LIQUIDITY SWEEP', color.rgb(130, 135, 142))
    bool upBreak = freshStructureBreak(1, sh, shBar, brokenHighPivot, close[1], close)
    bool downBreak = freshStructureBreak(-1, slw, slBar, brokenLowPivot, close[1], close)
    int nextStructure = uniqueStructureDirection(upBreak, downBreak)
    if nextStructure != 0
        if nextStructure == 1
            brokenHighPivot := shBar
            array.push(bullBreakPivots, shBar)
            array.push(bullBreakBars, bar_index)
            if array.size(bullBreakPivots) > 6
                array.shift(bullBreakPivots)
                array.shift(bullBreakBars)
        else
            brokenLowPivot := slBar
            array.push(bearBreakPivots, slBar)
            array.push(bearBreakBars, bar_index)
            if array.size(bearBreakPivots) > 6
                array.shift(bearBreakPivots)
                array.shift(bearBreakBars)
        contextStructureCaption := (nextStructure == 1 ? 'Bullish ' : 'Bearish ') + (chartStructure != 0 and chartStructure != nextStructure ? 'CHoCH' : 'BOS')
        if showStructure
            string annotation = contextStructureCaption + (hTrend != 0 and hTrend != nextStructure ? ' · Counter H1' : '')
            structureTag(close, annotation, nextStructure == 1 ? color.rgb(44, 153, 124) : color.rgb(220, 73, 83))
        chartStructure := nextStructure
    // Repeated horizontal levels use only pivots confirmed now; usable by modules from the next bar.
    if not na(ph)
        if not na(srHigh) and math.abs(ph - srHigh) <= atr * levelTolerance
            srHighTouches += 1
        else
            srHigh := ph
            srHighTouches := 1
    if not na(pl)
        if not na(srLow) and math.abs(pl - srLow) <= atr * levelTolerance
            srLowTouches += 1
        else
            srLow := pl
            srLowTouches := 1
    // Ambiguous bars confirming both pivot types are excluded from QM sequencing.
    if (not na(ph)) != (not na(pl))
        int pDir = not na(ph) ? 1 : -1
        float pPrice = not na(ph) ? ph : pl
        int count = array.size(pivotDirs)
        if count == 0
            array.push(pivotDirs, pDir)
            array.push(pivotPrices, pPrice)
            array.push(pivotTimes, bar_index)
        else if array.get(pivotDirs, count - 1) == pDir
            float previous = array.get(pivotPrices, count - 1)
            if pDir == 1 ? pPrice > previous : pPrice < previous
                array.set(pivotPrices, count - 1, pPrice)
                array.set(pivotTimes, count - 1, bar_index)
        else
            array.push(pivotDirs, pDir)
            array.push(pivotPrices, pPrice)
            array.push(pivotTimes, bar_index)
            if array.size(pivotDirs) > 5
                array.shift(pivotDirs)
                array.shift(pivotPrices)
                array.shift(pivotTimes)
    if not na(ph)
        if showStructure and showSwingLabels and not na(sh)
            structureTag(ph, math.abs(ph - sh) <= atr * 0.1 ? 'Equal highs' : ph > sh ? 'Higher high' : 'Lower high', color.rgb(71, 85, 105))
        sh := ph
        shBar := bar_index
    if not na(pl)
        if showStructure and showSwingLabels and not na(slw)
            structureTag(pl, math.abs(pl - slw) <= atr * 0.1 ? 'Equal lows' : pl > slw ? 'Higher low' : 'Lower low', color.rgb(71, 85, 105))
        slw := pl
        slBar := bar_index
// STRATEGY_ORDER_ADAPTER
// REVIEW_DRAWINGS_BEGIN — presentation only; the qualified-plan engine is unchanged.
var int clearPlanTime = na
var string clearPlanSide = ''
var string clearPlanModule = ''
// Visible-range data controls label spacing only. It never feeds a trading predicate.
var float clearVisibleHigh = na
var float clearVisibleLow = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    clearVisibleHigh := na(clearVisibleHigh) ? high : math.max(clearVisibleHigh, high)
    clearVisibleLow := na(clearVisibleLow) ? low : math.min(clearVisibleLow, low)

type ClearSignalPlan
    array<line> priceLines
    array<line> connectors
    array<label> priceLabels
    array<float> prices
    box riskArea
    box rewardArea
    int startTime
    int planTimestamp
    int endTime
    int direction
    bool isOpen
    string module
    string terminal

var array<ClearSignalPlan> clearPlans = array.new<ClearSignalPlan>()

method clearDelete(ClearSignalPlan view) =>
    for level in view.priceLines
        line.delete(level)
    for connector in view.connectors
        line.delete(connector)
    for tag in view.priceLabels
        label.delete(tag)
    box.delete(view.riskArea)
    box.delete(view.rewardArea)

method clearRender(ClearSignalPlan view, float visibleHigh, float visibleLow) =>
    int stepMs = int(timeframe.in_seconds() * 1000)
    float top = math.max(nz(visibleHigh, high), array.max(view.prices))
    float bottom = math.min(nz(visibleLow, low), array.min(view.prices))
    float gap = clearSpaceLabels ? math.max(syminfo.mintick * 2, (top - bottom) * 0.026) : 0
    array<float> placed = array.copy(view.prices)
    array<int> ascending = view.direction == 1 ? array.from(1, 0, 2, 3, 4) : array.from(4, 3, 2, 0, 1)
    float previousY = na
    for index in ascending
        float price = array.get(view.prices, index)
        float captionY = na(previousY) ? price : math.max(price, previousY + gap)
        array.set(placed, index, captionY)
        previousY := captionY
    // Center the spaced group around the original price range; connectors retain exact levels.
    float shift = (array.max(placed) - array.max(view.prices)) / 2
    array<string> names = array.from((view.direction == 1 ? 'BUY' : 'SELL') + ' ' + str.substring(view.module, 0, 1) + ' Entry ', 'SL ', 'TP1 ', 'TP2 ', 'TP3 ')
    for index = 0 to 4
        line level = array.get(view.priceLines, index)
        line connector = array.get(view.connectors, index)
        label tag = array.get(view.priceLabels, index)
        float price = array.get(view.prices, index)
        float captionY = array.get(placed, index) - shift
        int labelTime = view.endTime + stepMs * 2
        line.set_x2(level, view.endTime)
        line.set_style(level, view.isOpen ? line.style_solid : line.style_dashed)
        line.set_xy1(connector, view.endTime, price)
        line.set_xy2(connector, labelTime, captionY)
        label.set_xy(tag, labelTime, captionY)
        bool visible = index == 0 ? showEntryLine : index == 1 ? showSLLine : index == 2 ? showTP1Line : index == 3 ? showTP2Line : showTP3Line
        color levelColor = view.isOpen ? (index == 0 ? color.rgb(110, 116, 125) : index == 1 ? color.rgb(239, 68, 68) : color.rgb(47, 158, 68)) : color.rgb(135, 143, 155)
        line.set_color(level, visible ? color.new(levelColor, view.isOpen ? 0 : 35) : na)
        line.set_color(connector, visible ? color.new(levelColor, view.isOpen ? 0 : 35) : na)
        label.set_color(tag, visible ? color.new(levelColor, view.isOpen ? 0 : 20) : na)
        label.set_textcolor(tag, visible ? color.white : na)
        label.set_size(tag, chartText)
        string suffix = index == 0 and not view.isOpen ? '\n' + view.terminal : ''
        label.set_text(tag, array.get(names, index) + priceText(price) + suffix)
    if not na(view.riskArea)
        box.set_right(view.riskArea, view.endTime)
        box.set_right(view.rewardArea, view.endTime)
        if not view.isOpen
            box.set_bgcolor(view.riskArea, color.new(color.gray, 96))
            box.set_bgcolor(view.rewardArea, color.new(color.gray, 96))
            box.set_border_color(view.riskArea, color.new(color.gray, 80))
            box.set_border_color(view.rewardArea, color.new(color.gray, 80))

// Freeze an ended plan instead of stretching yesterday's risk box to the current candle.
if barstate.isconfirmed and array.size(clearPlans) > 0
    ClearSignalPlan latestView = array.last(clearPlans)
    if latestView.isOpen
        int minimumEnd = latestView.startTime + int(timeframe.in_seconds() * 1000) * clearLevelBars
        latestView.endTime := math.max(minimumEnd, time_close)
        if newSignal or not (active or pending)
            latestView.isOpen := false
            bool cancelledPlan = not newSignal and (status == 'EXPIRED' or str.startswith(status, 'INVALIDATED'))
            bool knownClose = reviewOutcome.planTime == latestView.planTimestamp and not na(reviewOutcome.closeTime)
            latestView.endTime := knownClose ? reviewOutcome.closeTime : time_close
            latestView.terminal := knownClose ? reviewCloseCaption(reviewOutcome.code, useBroker) + ' ' + str.format_time(reviewOutcome.closeTime, 'HH:mm', 'UTC') + ' UTC' : cancelledPlan ? statusName(status) : 'Ended; reason unavailable'

if newSignal and showTrade and (active or pending or not useBroker)
    clearPlanTime := signalTime
    clearPlanSide := dir == 1 ? 'BUY' : 'SELL'
    clearPlanModule := selectedStrategy
    array<float> planPrices = array.from(entry, stop, tp1, tp2, tp3)
    array<bool> visiblePrices = array.from(showEntryLine, showSLLine, showTP1Line, showTP2Line, showTP3Line)
    array<line> planLines = array.new<line>()
    array<line> planConnectors = array.new<line>()
    array<label> planLabels = array.new<label>()
    int projectedEnd = time + int(timeframe.in_seconds() * 1000) * clearLevelBars
    box riskArea = na
    box rewardArea = na
    if showRiskReward
        riskArea := box.new(time, math.max(entry, stop), projectedEnd, math.min(entry, stop), xloc=xloc.bar_time, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 65))
        rewardArea := box.new(time, math.max(entry, tp3), projectedEnd, math.min(entry, tp3), xloc=xloc.bar_time, bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 65))
    for index = 0 to 4
        float price = array.get(planPrices, index)
        color levelColor = index == 0 ? color.rgb(110, 116, 125) : index == 1 ? color.rgb(239, 68, 68) : color.rgb(47, 158, 68)
        bool visible = array.get(visiblePrices, index)
        array.push(planLines, line.new(time, price, projectedEnd, price, xloc=xloc.bar_time, color=visible ? levelColor : na, width=1))
        array.push(planConnectors, line.new(projectedEnd, price, projectedEnd, price, xloc=xloc.bar_time, color=visible ? levelColor : na))
        array.push(planLabels, label.new(projectedEnd, price, '', xloc=xloc.bar_time, style=label.style_label_left, color=visible ? levelColor : na, textcolor=visible ? color.white : na, size=chartText))
    array.push(clearPlans, ClearSignalPlan.new(planLines, planConnectors, planLabels, planPrices, riskArea, rewardArea, time, signalTime, projectedEnd, dir, active or pending, selectedStrategy, 'ENDED'))
    if array.size(clearPlans) > clearPlanLimit
        ClearSignalPlan oldestView = array.shift(clearPlans)
        oldestView.clearDelete()

if barstate.islast or barstate.islastconfirmedhistory
    for view in clearPlans
        bool visiblePlan = view.isOpen or showLastPlan
        if visiblePlan
            view.clearRender(clearVisibleHigh, clearVisibleLow)
        else
            view.clearDelete()
// REVIEW_DRAWINGS_END
plot(showEMA and visualLayout == 'Dashboard' ? ema9 : na, 'EMA 9', color=color.aqua)
plot(showEMA ? ema21 : na, 'EMA 21', color=color.rgb(228, 163, 46), linewidth=1)
plot(showEMA and useEMA50 and visualLayout == 'Dashboard' ? ema50 : na, 'Strategy EMA 50', color=color.blue)
plot(showDaily ? pdh : na, 'Previous day high', color=color.new(color.green, 35), style=plot.style_stepline)
plot(showDaily ? pdl : na, 'Previous day low', color=color.new(color.red, 35), style=plot.style_stepline)
plot(showDaily ? pwh : na, 'Previous week high', color=color.new(color.green, 65), style=plot.style_stepline)
plot(showDaily ? pwl : na, 'Previous week low', color=color.new(color.red, 65), style=plot.style_stepline)
plot(showSessionLevels ? sessionHigh : na, 'Session high', color=color.new(color.blue, 50))
plot(showSessionLevels ? sessionLow : na, 'Session low', color=color.new(color.blue, 50))
plot(showFibonacci and sh > slw ? sh - (sh - slw) * 0.618 : na, 'Bullish 61.8%', color=color.new(color.orange, 50))
plot(showFibonacci and sh > slw ? slw + (sh - slw) * 0.618 : na, 'Bearish 61.8%', color=color.new(color.orange, 50))
plot(showPremiumDiscount or showFibonacci ? (sh + slw) / 2 : na, 'Premium/discount midpoint 50%', color=color.new(color.gray, 50))
plot(showBreakers ? bullBreaker : na, 'Bullish breaker level', color=color.new(color.green, 35), style=plot.style_circles)
plot(showBreakers ? bearBreaker : na, 'Bearish breaker level', color=color.new(color.red, 35), style=plot.style_circles)
plotshape(showWyckoff and barstate.isconfirmed and bullSpring, 'Spring candidate', shape.triangleup, location.belowbar, color.purple, size=size.tiny)
plotshape(showWyckoff and barstate.isconfirmed and bearUpthrust, 'Upthrust candidate', shape.triangledown, location.abovebar, color.purple, size=size.tiny)
plot(active ? managedStop : na, 'Managed SL (next bar)', color=color.red, style=plot.style_linebr)
// Read-only explanation of the most recent confirmed-bar decision. Never opens orders.
if barstate.isconfirmed
    decisionState := readinessState(dir, pending, active or brokerBusy, entryTriggered)
    if pending or active or brokerBusy
        decisionReason := pending ? 'Qualified plan; waiting for ' + (entryMode == 'Limit' ? 'limit fill' : entryMode == 'Breakout' ? 'breakout fill' : 'emulator market fill') + ' · not executed yet' : signalReason
        decisionProgress := pending ? 'Setup ✓ → Confirmation ✓ → Risk ✓ → Fill …' : 'Setup ✓ → Confirmation ✓ → Risk ✓ → Entry triggered (sim.)'
    else
        string commonBlock = newSignal and status == 'REJECTED: INVALID UNIT SIZE' ? 'Simulation quantity below feed minimum / invalid conversion' : not (enableA or enableB or enableC or enableD or enableE or enableF or enableG or enableH) ? 'All strategies disabled' : cancelOrder ? 'Previous order cancelled; reevaluate on a later bar' : pause ? 'Manual news pause' : not researchBarAllowed(useResearchWindow, researchStart, researchEnd, time, time_close) ? 'Outside research date window' : useSession and not inSession ? 'Outside selected session' : not volOK ? 'ATR filtered / warming up' : sessionTrades >= maxTrades ? 'Session plan limit' : not na(lastSignal) and bar_index - lastSignal < cooldown ? 'Signal cooldown' : ''
        string effectiveBlock = commonBlock != '' ? commonBlock : validationReason == 'Opposing qualified directions; no trade' ? validationReason : ''
        decisionReason := effectiveBlock != '' ? effectiveBlock : validationReason
        decisionProgress := 'No qualified setup → WAIT'
        if enableA and stage > 0
            decisionProgress := stage == 1 ? 'Sweep ✓ → MSS … + FVG … → Retest … → Risk …' : 'Sweep ✓ → MSS ✓ + FVG ✓ → Retest … → Risk …'
            if effectiveBlock == ''
                decisionReason := stage == 1 ? 'Need a later displaced MSS candle with FVG' : candA.ready ? validationReason : 'Need a later FVG retest and directional close'
        else
            for candidate in candidates
                if candidate.enabled and candidate.stage > 0
                    decisionProgress := strategyName(candidate.id) + ' → ' + (candidate.ready ? 'Trigger ✓ → risk checks' : 'Setup ✓ → later confirmation …')
                    if effectiveBlock == ''
                        decisionReason := candidate.ready ? candidate.rejectionReason : 'Waiting for later setup-specific confirmation'
                    break
    if newSignal and useBroker and not pending and not active and status == 'REJECTED: INVALID UNIT SIZE'
        decisionProgress := 'Setup ✓ → Confirmation ✓ → Execution quantity rejected'
// Presentation-only context. None of these objects or flags feed the trading candidates.
type HistoricalPlan
    array<line> priceLines
    array<label> priceLabels
    bool isOpen
var array<HistoricalPlan> historicalPlans = array.new<HistoricalPlan>()

createHistoricalPlan(int direction, string strategyId, float planned, float stopPrice, float targetOne, float targetTwo, float targetThree, int keepPlans) =>
    array<line> planLines = array.new<line>()
    array<label> planLabels = array.new<label>()
    array<float> planPrices = array.from(planned, stopPrice, targetOne, targetTwo, targetThree)
    array<string> planNames = array.from((direction == 1 ? 'BUY ' : 'SELL ') + str.substring(strategyId, 0, 1) + ' ', 'SL ', 'T1 ', 'T2 ', 'T3 ')
    array<color> planColors = array.from(color.rgb(71, 85, 105), color.rgb(185, 28, 28), color.rgb(21, 128, 61), color.rgb(21, 128, 61), color.rgb(21, 128, 61))
    for i = 0 to 4
        float level = array.get(planPrices, i)
        color levelColor = array.get(planColors, i)
        int labelBar = bar_index + 2 + i * 12
        array.push(planLines, line.new(bar_index, level, labelBar, level, color=color.new(levelColor, 15), width=i == 0 ? 2 : 1))
        array.push(planLabels, label.new(labelBar, level, array.get(planNames, i) + priceText(level), style=label.style_label_left, color=color.new(levelColor, contextTransparency), textcolor=panelValue, size=size.tiny))
    array.push(historicalPlans, HistoricalPlan.new(planLines, planLabels, true))
    if array.size(historicalPlans) > keepPlans
        HistoricalPlan oldest = array.shift(historicalPlans)
        for oldLine in oldest.priceLines
            line.delete(oldLine)
        for oldLabel in oldest.priceLabels
            label.delete(oldLabel)
    0

updateHistoricalPlans(bool planActive) =>
    if array.size(historicalPlans) > 0
        for index = 0 to array.size(historicalPlans) - 1
            HistoricalPlan view = array.get(historicalPlans, index)
            if view.isOpen
                bool latest = index == array.size(historicalPlans) - 1
                bool stillActive = latest and planActive
                int endBar = stillActive ? bar_index + 1 : bar_index
                for lineIndex = 0 to array.size(view.priceLines) - 1
                    line planLine = array.get(view.priceLines, lineIndex)
                    int labelBar = endBar + 2 + lineIndex * 12
                    line.set_x2(planLine, labelBar)
                for labelIndex = 0 to array.size(view.priceLabels) - 1
                    label planLabel = array.get(view.priceLabels, labelIndex)
                    if labelIndex < 5
                        label.set_x(planLabel, endBar + 2 + labelIndex * 12)
                if not stillActive
                    label entryTag = array.get(view.priceLabels, 0)
                    string terminal = status == 'CLOSED' ? 'CLOSED' : status == 'EXPIRED' ? 'EXPIRED' : str.startswith(status, 'INVALIDATED') ? 'INVALID' : statusName(status)
                    label.set_text(entryTag, label.get_text(entryTag) + ' · ' + terminal)
                    view.isOpen := false
                    array.set(historicalPlans, index, view)

bool referenceView = visualLayout == 'Reference'
color bullColor = color.rgb(44, 153, 124)
color bearColor = color.rgb(220, 73, 83)
color sweepColor = color.rgb(130, 135, 142)
float visualEMA55 = ta.ema(close, 55)
plot(referenceView and showEMA and showEMA55 ? visualEMA55 : na, 'Visual EMA 55', color=color.rgb(54, 88, 214), linewidth=2)
// Pivots step only on their confirmation bars; no negative offsets.
plot(referenceView and showSwingLevels and (na(brokenHighPivot) or shBar != brokenHighPivot) ? sh : na, 'Confirmed swing high', color=color.new(bearColor, 65), style=plot.style_stepline)
plot(referenceView and showSwingLevels and (na(brokenLowPivot) or slBar != brokenLowPivot) ? slw : na, 'Confirmed swing low', color=color.new(bullColor, 65), style=plot.style_stepline)

rightTag(label previous, int x, float price, string caption, color background) =>
    label result = previous
    if na(price)
        if not na(result)
            label.delete(result)
        result := na
    else if na(result)
        result := label.new(x, price, caption, style=label.style_label_left, color=color.new(background, contextTransparency), textcolor=panelValue, size=chartText)
    else
        label.set_xy(result, x, price)
        label.set_text(result, caption)
        label.set_color(result, color.new(background, contextTransparency))
        label.set_textcolor(result, panelValue)
        label.set_size(result, chartText)
    result

var label highTag = na
var label lowTag = na
var label fastTag = na
var label slowTag = na
var box supportArea = na
var box resistanceArea = na
var box demandOB = na
var box supplyOB = na
var box bullGap = na
var box bearGap = na
var float drawnSupport = na
var float drawnResistance = na
var int supportTouches = 0
var int resistanceTouches = 0
var float drawnBullOB = na
var float drawnBearOB = na
var int bullGapBar = na
var int bearGapBar = na
var int sweptHighPivot = na
var int sweptLowPivot = na
var int sweptCRTHigh = na
var int sweptCRTLow = na
var string recentContextPattern = 'Waiting for a confirmed pattern'
var int recentContextTime = na
var int lastHighCaption = na
var int lastLowCaption = na

if barstate.isconfirmed and referenceView
    // Use the pivot levels known before this candle, independently of strategy enablement.
    bool highSweep = showContextSweeps and not na(sh[1]) and not na(slw[1]) and rangeSweep(-1, slw[1], sh[1], high, low, close) and (na(sweptHighPivot) or sweptHighPivot != shBar[1])
    bool lowSweep = showContextSweeps and not na(sh[1]) and not na(slw[1]) and rangeSweep(1, slw[1], sh[1], high, low, close) and (na(sweptLowPivot) or sweptLowPivot != slBar[1])
    bool crtSupported = timeframe.in_seconds(crtTF) >= timeframe.in_seconds()
    bool crtHighSweep = showCRTSweeps and crtSupported and rangeSweep(-1, crtLow, crtHigh, high, low, close) and (na(sweptCRTHigh) or sweptCRTHigh != crtTime)
    bool crtLowSweep = showCRTSweeps and crtSupported and rangeSweep(1, crtLow, crtHigh, high, low, close) and (na(sweptCRTLow) or sweptCRTLow != crtTime)
    if highSweep or crtHighSweep
        string caption = highSweep and crtHighSweep ? 'HIGH LIQUIDITY SWEEP\nCRT HIGH SWEEP' : highSweep ? 'HIGH LIQUIDITY SWEEP' : 'CRT HIGH SWEEP'
        if showStructure and (na(lastHighCaption) or bar_index - lastHighCaption >= contextLabelGap)
            structureTag(high, caption, sweepColor)
            lastHighCaption := bar_index
        recentContextPattern := highSweep and crtHighSweep ? 'High sweep + CRT reclaim' : highSweep ? 'High liquidity sweep' : 'CRT high sweep'
        recentContextTime := time_close
    if lowSweep or crtLowSweep
        string caption = lowSweep and crtLowSweep ? 'LOW LIQUIDITY SWEEP\nCRT LOW SWEEP' : lowSweep ? 'LOW LIQUIDITY SWEEP' : 'CRT LOW SWEEP'
        if showStructure and (na(lastLowCaption) or bar_index - lastLowCaption >= contextLabelGap)
            structureTag(low, caption, sweepColor)
            lastLowCaption := bar_index
        recentContextPattern := highSweep or crtHighSweep ? 'Both sides swept · ambiguous' : lowSweep and crtLowSweep ? 'Low sweep + CRT reclaim' : lowSweep ? 'Low liquidity sweep' : 'CRT low sweep'
        recentContextTime := time_close
    if highSweep
        sweptHighPivot := shBar[1]
    if lowSweep
        sweptLowPivot := slBar[1]
    if crtHighSweep
        sweptCRTHigh := crtTime
    if crtLowSweep
        sweptCRTLow := crtTime

    // Repeated confirmed pivot clusters, with frozen ATR width at recognition.
    if showSupportResistance
        if not na(srLow) and srLowTouches >= 2 and close >= srLow - atr * levelTolerance and (na(drawnSupport) or srLow != drawnSupport or srLowTouches > supportTouches)
            box.delete(supportArea)
            supportArea := box.new(bar_index, srLow + atr * levelTolerance, bar_index + zoneExtension, srLow - atr * levelTolerance, border_color=color.new(bullColor, 35), bgcolor=color.new(bullColor, 92), text='K-SNR SUPPORT', text_color=bullColor, text_size=chartText, text_halign=text.align_right)
            drawnSupport := srLow
            supportTouches := srLowTouches
        if not na(srHigh) and srHighTouches >= 2 and close <= srHigh + atr * levelTolerance and (na(drawnResistance) or srHigh != drawnResistance or srHighTouches > resistanceTouches)
            box.delete(resistanceArea)
            resistanceArea := box.new(bar_index, srHigh + atr * levelTolerance, bar_index + zoneExtension, srHigh - atr * levelTolerance, border_color=color.new(bearColor, 35), bgcolor=color.new(bearColor, 92), text='K-SNR RESISTANCE', text_color=bearColor, text_size=chartText, text_halign=text.align_right)
            drawnResistance := srHigh
            resistanceTouches := srHighTouches
        if not na(supportArea)
            if close < box.get_bottom(supportArea)
                box.delete(supportArea)
                supportArea := na
            else
                box.set_right(supportArea, bar_index + zoneExtension)
        if not na(resistanceArea)
            if close > box.get_top(resistanceArea)
                box.delete(resistanceArea)
                resistanceArea := na
            else
                box.set_right(resistanceArea, bar_index + zoneExtension)

    // Existing displacement/previous-opposite-candle OB heuristic; two live zones maximum.
    if showOB
        if na(bullOBLow)
            box.delete(demandOB)
            demandOB := na
            drawnBullOB := na
        else if na(drawnBullOB) or bullOBLow != drawnBullOB or (not na(demandOB) and bullOBHigh != box.get_top(demandOB))
            box.delete(demandOB)
            demandOB := box.new(bar_index, bullOBHigh, bar_index + zoneExtension, bullOBLow, border_color=color.new(color.teal, 25), bgcolor=color.new(color.teal, 93), text='BULL OB · candidate', text_color=color.teal, text_size=chartText, text_halign=text.align_right)
            drawnBullOB := bullOBLow
        if na(bearOBHigh)
            box.delete(supplyOB)
            supplyOB := na
            drawnBearOB := na
        else if na(drawnBearOB) or bearOBHigh != drawnBearOB or (not na(supplyOB) and bearOBLow != box.get_bottom(supplyOB))
            box.delete(supplyOB)
            supplyOB := box.new(bar_index, bearOBHigh, bar_index + zoneExtension, bearOBLow, border_color=color.new(bearColor, 25), bgcolor=color.new(bearColor, 93), text='BEAR OB · candidate', text_color=bearColor, text_size=chartText, text_halign=text.align_right)
            drawnBearOB := bearOBHigh
        if not na(demandOB)
            box.set_right(demandOB, bar_index + zoneExtension)
        if not na(supplyOB)
            box.set_right(supplyOB, bar_index + zoneExtension)

    // Displacement FVG context, identified now, never backdated to the first candle.
    if showZones
        bool bullishGap = low > high[2] and close[1] > open[1] and math.abs(close[1] - open[1]) >= atr[1] * minDisp
        bool bearishGap = high < low[2] and close[1] < open[1] and math.abs(close[1] - open[1]) >= atr[1] * minDisp
        if bullishGap
            box.delete(bullGap)
            bullGap := box.new(bar_index, low, bar_index + zoneExtension, high[2], border_color=color.new(bullColor, 45), bgcolor=color.new(bullColor, 94), text='BULL FVG', text_color=bullColor, text_size=chartText, text_halign=text.align_right)
            bullGapBar := bar_index
        if bearishGap
            box.delete(bearGap)
            bearGap := box.new(bar_index, low[2], bar_index + zoneExtension, high, border_color=color.new(bearColor, 45), bgcolor=color.new(bearColor, 94), text='BEAR FVG', text_color=bearColor, text_size=chartText, text_halign=text.align_right)
            bearGapBar := bar_index
        if not na(bullGap)
            if bar_index > bullGapBar and low <= box.get_bottom(bullGap)
                box.delete(bullGap)
                bullGap := na
            else
                box.set_right(bullGap, bar_index + zoneExtension)
        if not na(bearGap)
            if bar_index > bearGapBar and high >= box.get_top(bearGap)
                box.delete(bearGap)
                bearGap := na
            else
                box.set_right(bearGap, bar_index + zoneExtension)

trimContextBox(box area) =>
    box result = area
    if not na(area)
        bool staleArea = bar_index - box.get_left(area) > contextZoneBars
        bool distantArea = math.abs((box.get_top(area) + box.get_bottom(area)) / 2 - close) > atr * contextZoneDistance
        if staleArea or distantArea
            box.delete(area)
            result := na
    result
if barstate.isconfirmed and referenceView
    supportArea := trimContextBox(supportArea)
    resistanceArea := trimContextBox(resistanceArea)
    demandOB := trimContextBox(demandOB)
    supplyOB := trimContextBox(supplyOB)
    bullGap := trimContextBox(bullGap)
    bearGap := trimContextBox(bearGap)
var table conceptPanel = table.new(position.middle_right, 2, 9, frame_color=color.new(color.gray, 65), frame_width=1, bgcolor=color.new(color.white, 8))
if barstate.islast or barstate.islastconfirmedhistory
    highTag := rightTag(highTag, bar_index + zoneExtension + 14, referenceView and showSwingLevels and (na(brokenHighPivot) or shBar != brokenHighPivot) ? sh : na, 'SWING HIGH  ' + priceText(sh), bearColor)
    lowTag := rightTag(lowTag, bar_index + zoneExtension + 14, referenceView and showSwingLevels and (na(brokenLowPivot) or slBar != brokenLowPivot) ? slw : na, 'SWING LOW  ' + priceText(slw), bullColor)
    fastTag := rightTag(fastTag, bar_index + zoneExtension, referenceView and showEMA ? ema21 : na, 'EMA 21', color.rgb(228, 163, 46))
    slowTag := rightTag(slowTag, bar_index + zoneExtension + 6, referenceView and showEMA and showEMA55 ? visualEMA55 : na, 'EMA 55', color.rgb(54, 88, 214))
    table.clear(conceptPanel, 0, 0, 1, 8)
    if referenceView and showConceptPanel
        string zoneNames = (not na(supportArea) or not na(resistanceArea) ? 'K-SNR ' : '') + (not na(demandOB) or not na(supplyOB) ? 'OB ' : '') + (not na(bullGap) or not na(bearGap) ? 'FVG' : '')
        string alignmentCaption = pending or active or brokerBusy ? signalAlignment : hTrend != 0 and chartStructure != 0 and chartStructure != hTrend ? 'Chart counter H1 · not an entry' : 'Chart aligned / neutral · not an entry'
        array<string> captions = array.from('GOLD EMPIRE · ANALYSIS', 'Decision · last closed bar', 'Why WAIT / READY', 'Setup progress', 'H1 / M15 direction', 'Chart structure', 'Alignment context', 'Context zones (display)', 'Price levels')
        array<string> descriptions = array.from('CONTEXT ≠ BUY / SELL', decisionState, str.replace_all(decisionReason, ' | ', '\n'), decisionProgress, (hTrend == 1 ? 'Bullish' : hTrend == -1 ? 'Bearish' : 'Neutral') + ' / ' + (mTrend == 1 ? 'Bullish' : mTrend == -1 ? 'Bearish' : 'Neutral'), contextStructureCaption, alignmentCaption, zoneNames == '' ? 'No fresh nearby display zones' : zoneNames, pending or active or brokerBusy ? 'Qualified plan only · see chart' : 'Hidden until a plan passes all checks')
        for row = 0 to 8
            color rowColor = row == 0 ? color.rgb(235, 240, 244) : color.new(color.white, 8)
            table.cell(conceptPanel, 0, row, array.get(captions, row), text_color=color.rgb(71, 85, 105), text_size=panelText, text_halign=text.align_left, bgcolor=rowColor)
            table.cell(conceptPanel, 1, row, array.get(descriptions, row), text_color=color.rgb(30, 41, 59), text_size=panelText, text_halign=text.align_left, bgcolor=rowColor)

// Plan history is a read-only overlay. It starts at the confirmed plan bar and never submits orders or alerts.
bool inHistoryWindow = historyMode != 'Full bounded' or bar_index >= last_bar_index - historyLookback
if barstate.isconfirmed and newSignal and historyMode != 'Off' and inHistoryWindow and (active or pending or not useBroker)
    createHistoricalPlan(dir, selectedStrategy, entry, stop, tp1, tp2, tp3, historyPlanLimit)
if barstate.isconfirmed and array.size(historicalPlans) > 0
    updateHistoricalPlans(active or pending or brokerBusy)
var table dash = table.new(position.top_right, 2, 19, bgcolor=panelBackground, frame_color=color.rgb(71, 85, 105), frame_width=1)
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(dash, 0, 0, 1, 18)
    bool currentPlan = active or pending or brokerBusy
    string displayStrategy = currentPlan or showLastPlan ? strategyName(selectedStrategy) : 'Waiting for a setup'
    string displayStatus = statusName(status)
    string displayQuality = currentPlan or showLastPlan ? str.tostring(quality) + ' / 100' : 'Not scored yet'
    int displayDirection = currentPlan or showLastPlan ? dir : 0
    float displayEntry = currentPlan or showLastPlan ? entry : na
    float displaySL = currentPlan or showLastPlan ? stop : na
    float display1 = currentPlan or showLastPlan ? tp1 : na
    float display2 = currentPlan or showLastPlan ? tp2 : na
    float display3 = currentPlan or showLastPlan ? tp3 : na
    float displayFill = currentPlan or showLastPlan ? filledEntry : na
    float displayManaged = currentPlan or showLastPlan ? managedStop : na
    string displaySource = currentPlan or showLastPlan ? targetSource : 'No current trade plan'
    if not currentPlan and not str.startswith(status, 'REJECTED')
        for c in candidates
            if c.enabled and c.stage > 0
                displayStrategy := strategyName(c.id)
                displayStatus := statusName(c.status)
                displayQuality := c.ready ? str.tostring(c.quality) + ' / 100' : 'Not scored yet'
                displayDirection := c.direction
                displayEntry := na
                displaySL := na
                display1 := na
                display2 := na
                display3 := na
                displayFill := na
                displayManaged := na
                displaySource := c.ready and c.confirmationTime == time_close and c.targetSource != '' ? c.targetSource : 'Targets not calculated yet'
                break
    if not currentPlan and displayStrategy == 'Waiting for a setup' and enableA and stage > 0
        displayStrategy := strategyName('A_')
        displayStatus := stage == 1 ? 'Sweep found · waiting for reversal' : 'Reversal found · waiting for entry'
        displayDirection := dir
    string planCaption = currentPlan ? (pending ? 'CURRENT · ORDER PENDING' : 'CURRENT · SIMULATED TRADE') : showLastPlan ? 'PREVIOUS PLAN / NEW SETUP' : 'NO CURRENT TRADE'
    float displayRisk = math.abs(displayEntry - displaySL)
    string rrText = not na(displayRisk) and displayRisk > 0 ? str.tostring(math.abs(display2 - displayEntry) / displayRisk, '#.##') + 'R  |  ' + str.tostring(riskPct) + '% risk' : '—'
    keys = array.from('SMART SCALPER PRO', 'Chart / execution', '1-hour trend', '15-minute structure', 'Plan information', 'Strategy', 'Setup status', 'Direction', 'Setup score · not win %', 'Session / volatility', 'Planned entry', 'Initial stop loss', 'Take profit 1', 'Take profit 2', 'Take profit 3', 'Target 2 / planned risk', 'Target method', 'Simulated fill price', 'Current stop loss')
    vals = array.from(syminfo.ticker, timeframe.period + ' min', hTrend == 1 ? 'UPTREND' : hTrend == -1 ? 'DOWNTREND' : 'NEUTRAL', mTrend == 1 ? 'UPTREND' : mTrend == -1 ? 'DOWNTREND' : 'NEUTRAL', planCaption, displayStrategy, displayStatus, displayDirection == 1 ? (currentPlan ? 'BUY' : 'Potential BUY · not an entry') : displayDirection == -1 ? (currentPlan ? 'SELL' : 'Potential SELL · not an entry') : 'No entry', displayQuality, (inSession ? sessionPreset : 'Outside trading hours') + (volOK ? ' / Normal' : ' / Filtered'), priceText(displayEntry), priceText(displaySL), priceText(display1), priceText(display2), priceText(display3), rrText, displaySource, priceText(displayFill), priceText(displayManaged))
    if showDashboard and visualLayout == 'Dashboard'
        for i = 0 to 18
            color rowBackground = i == 0 ? panelHeader : i % 2 == 0 ? panelAlternate : panelBackground
            color valueColor = i == 7 and displayDirection != 0 ? (displayDirection == 1 ? color.rgb(21, 128, 61) : color.rgb(185, 28, 28)) : i == 4 ? color.rgb(146, 64, 14) : panelValue
            table.cell(dash, 0, i, array.get(keys, i), text_color=panelMuted, text_size=panelText, text_halign=text.align_left, bgcolor=rowBackground)
            table.cell(dash, 1, i, array.get(vals, i), text_color=valueColor, text_size=panelText, text_halign=text.align_left, bgcolor=rowBackground)

if auditLog and newSignal
    log.info('PLAN_AUDIT ' + '{"scriptVersion":"' + SCRIPT_VERSION + '","symbol":"' + jsonEscape(syminfo.tickerid) + '","timeframe":"' + timeframe.period + '","strategy":"' + selectedStrategy + '","timestamp":' + str.tostring(signalTime) + ',"setupTimestamp":' + str.tostring(signalSetupTime) + ',"direction":' + str.tostring(dir) + ',"entryMode":"' + entryMode + '","entry":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(stop, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"quality":' + str.tostring(quality) + ',"executionAccepted":' + (active or pending ? 'true' : 'false') + ',"executionModel":"' + (useBroker ? 'STRATEGY_EMULATOR' : 'INDICATOR_ESTIMATE') + '"}')

// REVIEW_BADGE_BEGIN — never creates plans, orders or alerts.
var table reviewBadge = table.new(position.top_right, 2, 12, frame_color=color.rgb(100, 116, 139), frame_width=1, bgcolor=color.rgb(42, 48, 60))
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(reviewBadge, 0, 0, 1, 11)
    if clearShowPriceCard
        bool hasPlan = showTrade and not na(clearPlanTime) and (active or pending or showLastPlan)
        bool livePlan = hasPlan and (active or pending)
        bool closedPlan = hasPlan and not livePlan and reviewOutcome.planTime == clearPlanTime
        string planState = livePlan ? clearPlanSide + (pending ? ' · pending' : useBroker ? ' · simulated' : ' · estimate') : 'WAIT' + (hasPlan ? ' · previous ' + clearPlanSide : '')
        string closeCaption = closedPlan ? reviewCloseCaption(reviewOutcome.code, useBroker) + ' ' + str.format_time(reviewOutcome.closeTime, 'HH:mm', 'UTC') + ' UTC' : hasPlan and not livePlan ? 'Ended; reason unavailable' : 'No closed current plan'
        if closedPlan and useBroker and not na(reviewOutcome.net)
            closeCaption += ' · ' + (reviewOutcome.net >= 0 ? '+' : '') + str.tostring(reviewOutcome.net, '#.##') + ' ' + reviewOutcome.accountCurrency
        string execution = pending ? 'Awaiting fill · not executed' : useBroker ? 'Emulator' + (hasPlan ? ' fill ' + priceText(filledEntry) : '') : 'Indicator estimate · no broker fill'
        array<string> keys = array.from('SMART SCALPER · ' + timeframe.period + 'm', 'Why / last close', 'Concept / signal UTC', 'Entry planned', 'Initial SL', 'TP1', 'TP2', 'TP3', 'Target method', 'Last plan outcome', 'Execution model', 'Session / plans')
        array<string> values = array.from(planState, decisionReason, hasPlan ? reviewModuleName(clearPlanModule) + ' · ' + str.format_time(clearPlanTime, 'dd MMM HH:mm', 'UTC') : 'Waiting for a confirmed concept', hasPlan and showEntryLine ? priceText(entry) : '—', hasPlan and showSLLine ? priceText(stop) : '—', hasPlan and showTP1Line ? priceText(tp1) : '—', hasPlan and showTP2Line ? priceText(tp2) : '—', hasPlan and showTP3Line ? priceText(tp3) : '—', hasPlan ? targetSource : '—', closeCaption, execution, sessionPreset + (inSession ? ' open' : ' closed') + ' · ' + str.tostring(sessionTrades) + '/' + str.tostring(maxTrades))
        for row = 0 to 11
            color valueColor = not livePlan and row >= 3 and row <= 7 ? color.rgb(180, 190, 205) : row == 4 ? color.rgb(255, 130, 130) : row >= 5 and row <= 7 ? color.rgb(115, 225, 145) : color.white
            table.cell(reviewBadge, 0, row, array.get(keys, row), text_color=color.rgb(180, 190, 205), text_size=panelText, bgcolor=color.rgb(42, 48, 60), text_halign=text.align_left)
            table.cell(reviewBadge, 1, row, array.get(values, row), text_color=valueColor, text_size=panelText, bgcolor=row == 0 ? color.rgb(63, 71, 86) : color.rgb(42, 48, 60), text_halign=text.align_right)
// REVIEW_BADGE_END

// REVIEW_CONCEPT_VIEW_BEGIN — reads candidate state; never confirms or submits a trade.
reviewNeeded(Candidate c, int currentStage) =>
    str.startswith(c.id, 'A_') ? (currentStage == 1 ? 'Need later MSS + FVG' : 'Need later FVG retest') : str.startswith(c.id, 'G_') ? 'Need displaced range break' : str.startswith(c.id, 'E_') or str.startswith(c.id, 'H_') or (str.startswith(c.id, 'D_') and c.mode == 'Breakout retest') ? 'Need later directional retest' : 'Need later directional trigger close'
reviewShort(string value) => str.length(value) > 62 ? str.substring(value, 0, 59) + '…' : value
var array<box> reviewZones = array.new<box>()
var array<line> reviewTriggers = array.new<line>()
var array<line> reviewInvalidations = array.new<line>()
var array<label> reviewGuideTags = array.new<label>()
var array<line> reviewQmLines = array.new<line>()
if barstate.isfirst
    for index = 0 to 8
        array.push(reviewZones, box.new(time, close, time, close, xloc=xloc.bar_time, bgcolor=na, border_color=na))
        array.push(reviewTriggers, line.new(time, close, time, close, xloc=xloc.bar_time, color=na, style=line.style_dashed))
        array.push(reviewInvalidations, line.new(time, close, time, close, xloc=xloc.bar_time, color=na, style=line.style_dotted))
        array.push(reviewGuideTags, label.new(time, close, '', xloc=xloc.bar_time, style=label.style_label_left, color=na, textcolor=na, size=size.tiny))
    for index = 0 to 3
        array.push(reviewQmLines, line.new(bar_index, close, bar_index, close, color=na, style=line.style_dashed))

var table reviewBoard = table.new(position.bottom_right, 3, 10, frame_color=color.rgb(148, 163, 184), frame_width=1, bgcolor=color.new(color.white, 8))
var int reviewDecisionTime = na
if barstate.isconfirmed
    reviewDecisionTime := time_close
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(reviewBoard, 0, 0, 2, 9)
    for index = 0 to array.size(candidates) - 1
        Candidate c = array.get(candidates, index)
        int currentStage = index == 0 ? stage : c.stage
        bool visibleGuide = reviewShowGuides and c.enabled and currentStage > 0 and not (active or pending or brokerBusy)
        float lower = index == 0 ? (stage == 1 ? math.min(extreme, breakLevel) : gapBottom) : c.lower
        float upper = index == 0 ? (stage == 1 ? math.max(extreme, breakLevel) : gapTop) : c.upper
        float trigger = index == 0 ? (stage == 1 ? breakLevel : dir == 1 ? gapTop : gapBottom) : c.trigger
        float invalidation = index == 0 ? extreme : c.invalidation
        int start = index == 0 ? setupTime : c.setupTime
        color guideColor = index == 0 ? color.teal : index == 1 ? color.orange : index == 2 ? color.purple : index == 3 ? color.blue : index == 4 or index == 5 ? color.rgb(30, 130, 115) : index == 6 ? color.rgb(80, 105, 190) : index == 7 ? color.rgb(130, 85, 170) : color.fuchsia
        box zone = array.get(reviewZones, index)
        line triggerLine = array.get(reviewTriggers, index)
        line invalidLine = array.get(reviewInvalidations, index)
        label guideTag = array.get(reviewGuideTags, index)
        bool knownGuide = visibleGuide and not na(start) and not na(lower) and not na(upper) and upper >= lower
        box.set_bgcolor(zone, knownGuide ? color.new(guideColor, 94) : na)
        box.set_border_color(zone, knownGuide ? color.new(guideColor, 65) : na)
        line.set_color(triggerLine, knownGuide and not na(trigger) ? color.new(guideColor, 20) : na)
        line.set_color(invalidLine, knownGuide and not na(invalidation) ? color.new(color.red, 55) : na)
        label.set_text(guideTag, knownGuide ? reviewModuleName(c.id) + ' · SETUP ONLY' : '')
        label.set_textcolor(guideTag, knownGuide ? guideColor : na)
        label.set_color(guideTag, knownGuide ? color.new(color.white, 18) : na)
        if knownGuide
            int right = time_close + int(timeframe.in_seconds() * 1000) * 8
            box.set_lefttop(zone, start, upper)
            box.set_rightbottom(zone, right, lower)
            line.set_xy1(triggerLine, start, trigger)
            line.set_xy2(triggerLine, right, trigger)
            line.set_xy1(invalidLine, start, invalidation)
            line.set_xy2(invalidLine, right, invalidation)
            label.set_xy(guideTag, right, upper)
    bool qmKnown = reviewShowGuides and array.size(reviewQmBars) == 5 and array.size(reviewQmPrices) == 5 and (candH.stage > 0 or ((active or pending) and selectedStrategy == 'H_QUASIMODO' and reviewQm.setupTime == signalSetupTime))
    if qmKnown
        qmKnown := bar_index - array.get(reviewQmBars, 0) <= 1000
    for index = 0 to 3
        line segment = array.get(reviewQmLines, index)
        line.set_color(segment, qmKnown ? color.new(color.fuchsia, 35) : na)
        if qmKnown
            // X coordinates are pivot confirmation bars, not backdated pivot candles.
            line.set_xy1(segment, array.get(reviewQmBars, index), array.get(reviewQmPrices, index))
            line.set_xy2(segment, array.get(reviewQmBars, index + 1), array.get(reviewQmPrices, index + 1))
    if reviewShowBoard
        array<string> headers = array.from('A–H · last closed bar', 'State', 'Next confirmation / block')
        for col = 0 to 2
            table.cell(reviewBoard, col, 0, array.get(headers, col), text_color=color.rgb(30, 41, 59), text_size=size.tiny, bgcolor=color.rgb(226, 232, 240), text_halign=text.align_left)
        for module = 0 to 7
            int index = module <= 4 ? module : module + 1
            Candidate c = array.get(candidates, index)
            if module == 4 and (candSupply.ready or (candSupply.stage > 0 and candDemand.stage == 0))
                c := candSupply
            int currentStage = module == 0 ? stage : c.stage
            bool selected = (active or pending or brokerBusy) and str.substring(selectedStrategy, 0, 1) == str.substring(c.id, 0, 1)
            bool checked = c.ready and c.confirmationTime == reviewDecisionTime
            string stateCaption = not c.enabled ? 'OFF' : selected ? (pending ? 'PLAN PENDING' : 'PLAN ACTIVE') : checked ? (c.rejectionReason == '' ? 'TRIGGER ✓' : 'BLOCKED') : currentStage > 0 ? 'SETUP' : 'WAIT'
            string detail = not c.enabled ? 'Disabled in inputs' : selected ? signalReason : checked ? (c.rejectionReason == '' ? 'Qualified directions need arbitration' : c.rejectionReason) : currentStage > 0 ? ((active or pending or brokerBusy) ? 'Plan slot occupied' : reviewNeeded(c, currentStage)) : c.status == 'EXPIRED' or c.status == 'INVALIDATED' ? 'Last setup ' + str.lower(c.status) : 'Need a new confirmed setup'
            color rowBackground = module % 2 == 0 ? color.rgb(250, 252, 255) : color.rgb(241, 245, 249)
            table.cell(reviewBoard, 0, module + 1, reviewModuleName(c.id), text_color=color.rgb(51, 65, 85), text_size=size.tiny, bgcolor=rowBackground, text_halign=text.align_left)
            table.cell(reviewBoard, 1, module + 1, stateCaption, text_color=selected ? color.rgb(21, 128, 61) : checked ? color.rgb(146, 64, 14) : color.rgb(71, 85, 105), text_size=size.tiny, bgcolor=rowBackground, text_halign=text.align_left)
            table.cell(reviewBoard, 2, module + 1, reviewShort(detail), text_color=color.rgb(71, 85, 105), text_size=size.tiny, bgcolor=rowBackground, text_halign=text.align_left)
        table.cell(reviewBoard, 0, 9, 'Context ≠ entry', text_color=color.rgb(71, 85, 105), text_size=size.tiny, bgcolor=color.rgb(226, 232, 240))
        table.cell(reviewBoard, 1, 9, 'H1 ' + (hTrend == 1 ? '↑' : hTrend == -1 ? '↓' : '—') + ' / M15 ' + (mTrend == 1 ? '↑' : mTrend == -1 ? '↓' : '—'), text_color=color.rgb(71, 85, 105), text_size=size.tiny, bgcolor=color.rgb(226, 232, 240))
        table.cell(reviewBoard, 2, 9, reviewShort(decisionReason), text_color=color.rgb(71, 85, 105), text_size=size.tiny, bgcolor=color.rgb(226, 232, 240), text_halign=text.align_left)
// REVIEW_CONCEPT_VIEW_END

// DATA_SNAPSHOT_AUDIT_BEGIN — research logging only; no engine or alert mutations.
// The window uses chart-bar OPEN times, inclusively, in UTC.
dataSnapshotFloat(float value) => na(value) ? 'null' : str.tostring(value, '#.##########')
dataSnapshotInt(int value) => na(value) ? 'null' : str.tostring(value)
dataSnapshotBool(bool value) => value ? 'true' : 'false'
dataSnapshotCandidate(Candidate c) =>
    '{"id":"' + jsonEscape(c.id) + '","enabled":' + dataSnapshotBool(c.enabled) + ',"stage":' + str.tostring(c.stage) + ',"direction":' + str.tostring(c.direction) + ',"ready":' + dataSnapshotBool(c.ready) + ',"setupBar":' + dataSnapshotInt(c.setupBar) + ',"setupTime":' + dataSnapshotInt(c.setupTime) + ',"confirmationTime":' + dataSnapshotInt(c.confirmationTime) + ',"trigger":' + dataSnapshotFloat(c.trigger) + ',"lower":' + dataSnapshotFloat(c.lower) + ',"upper":' + dataSnapshotFloat(c.upper) + ',"invalidation":' + dataSnapshotFloat(c.invalidation) + ',"plannedEntry":' + dataSnapshotFloat(c.plannedEntry) + ',"quality":' + str.tostring(c.quality) + ',"status":"' + jsonEscape(c.status) + '","rejection":"' + jsonEscape(c.rejectionReason) + '"}'

var int dataSnapshotFirstLoadedTime = na
if barstate.isfirst
    dataSnapshotFirstLoadedTime := time
if barstate.isconfirmed and time >= timestamp('04 Nov 2026 09:30 +0000') and time <= timestamp('04 Nov 2026 10:20 +0000')
    string dataSnapshotCandidates = '['
    for snapshotIndex = 0 to array.size(candidates) - 1
        dataSnapshotCandidates += (snapshotIndex > 0 ? ',' : '') + dataSnapshotCandidate(array.get(candidates, snapshotIndex))
    dataSnapshotCandidates += ']'
    bool dataSnapshotPlanNow = newSignal and signalTime == time_close
    string dataSnapshotPlan = dataSnapshotPlanNow ? '{"timestamp":' + dataSnapshotInt(signalTime) + ',"setupTimestamp":' + dataSnapshotInt(signalSetupTime) + ',"strategy":"' + jsonEscape(selectedStrategy) + '","direction":' + str.tostring(dir) + ',"entryMode":"' + jsonEscape(entryMode) + '","entry":' + dataSnapshotFloat(entry) + ',"sl":' + dataSnapshotFloat(stop) + ',"tp1":' + dataSnapshotFloat(tp1) + ',"tp2":' + dataSnapshotFloat(tp2) + ',"tp3":' + dataSnapshotFloat(tp3) + ',"quality":' + str.tostring(quality) + '}' : 'null'
    string dataSnapshotPayload = '{"schema":"data-snapshot/v1","parentSourceSha256":"0a19862b22973e13a31abb29e59a75a18f3e0b84bb76deb2154eae7fa4cd1ed3","scriptVersion":"' + SCRIPT_VERSION + '","symbol":"' + jsonEscape(syminfo.tickerid) + '","timeframe":"' + timeframe.period + '","windowBasis":"BAR_OPEN_TIME","time":' + str.tostring(time) + ',"timeClose":' + str.tostring(time_close) + ',"barIndex":' + str.tostring(bar_index) + ',"lastBarIndex":' + str.tostring(last_bar_index) + ',"firstLoadedBarTime":' + dataSnapshotInt(dataSnapshotFirstLoadedTime) + ',"open":' + dataSnapshotFloat(open) + ',"high":' + dataSnapshotFloat(high) + ',"low":' + dataSnapshotFloat(low) + ',"close":' + dataSnapshotFloat(close) + ',"volume":' + dataSnapshotFloat(volume) + ',"mintick":' + dataSnapshotFloat(syminfo.mintick) + ',"atr":' + dataSnapshotFloat(atr) + ',"atrMean":' + dataSnapshotFloat(atrMean) + ',"ema9":' + dataSnapshotFloat(ema9) + ',"ema21":' + dataSnapshotFloat(ema21) + ',"ema50":' + dataSnapshotFloat(ema50) + ',"h1CompletedClose":' + dataSnapshotFloat(hClose) + ',"h1CompletedEMA50":' + dataSnapshotFloat(hEMA) + ',"hTrend":' + str.tostring(hTrend) + ',"mTrend":' + str.tostring(mTrend) + ',"crtTime":' + dataSnapshotInt(crtTime) + ',"crtHigh":' + dataSnapshotFloat(crtHigh) + ',"crtLow":' + dataSnapshotFloat(crtLow) + ',"pdh":' + dataSnapshotFloat(pdh) + ',"pdl":' + dataSnapshotFloat(pdl) + ',"pwh":' + dataSnapshotFloat(pwh) + ',"pwl":' + dataSnapshotFloat(pwl) + ',"swingHigh":' + dataSnapshotFloat(sh) + ',"swingLow":' + dataSnapshotFloat(slw) + ',"swingHighBar":' + dataSnapshotInt(shBar) + ',"swingLowBar":' + dataSnapshotInt(slBar) + ',"chartStructure":' + str.tostring(chartStructure) + ',"aStage":' + str.tostring(stage) + ',"direction":' + str.tostring(dir) + ',"active":' + dataSnapshotBool(active) + ',"pending":' + dataSnapshotBool(pending) + ',"brokerBusy":' + dataSnapshotBool(brokerBusy) + ',"cancelOrder":' + dataSnapshotBool(cancelOrder) + ',"slotAvailable":' + dataSnapshotBool(planSlotAvailable(active, pending, brokerBusy, cancelOrder)) + ',"sessionTrades":' + str.tostring(sessionTrades) + ',"maximumPlans":' + str.tostring(maxTrades) + ',"lastSignalBar":' + dataSnapshotInt(lastSignal) + ',"cooldownBars":' + str.tostring(cooldown) + ',"signalTime":' + dataSnapshotInt(signalTime) + ',"signalBar":' + dataSnapshotInt(signalBar) + ',"fillBar":' + dataSnapshotInt(fillBar) + ',"selectedStrategy":"' + jsonEscape(selectedStrategy) + '","status":"' + jsonEscape(status) + '","inSession":' + dataSnapshotBool(inSession) + ',"volatilityAllowed":' + dataSnapshotBool(volOK) + ',"paused":' + dataSnapshotBool(pause) + ',"decisionReason":"' + jsonEscape(decisionReason) + '","plan":' + dataSnapshotPlan + ',"candidates":' + dataSnapshotCandidates + '}'
    log.info('DATA_SNAPSHOT_AUDIT ' + dataSnapshotPayload)
// DATA_SNAPSHOT_AUDIT_END
