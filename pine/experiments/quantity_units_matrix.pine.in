//@version=6
strategy("RESEARCH ONLY · Integer exit quantity matrix", overlay=false, pyramiding=0, initial_capital=100000, currency=currency.USD, commission_type=strategy.commission.percent, commission_value=0, slippage=0, process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false, margin_long=100, margin_short=100)
// Synthetic historical order-mechanics cases. No production signals or alert calls.
startTime = input.time(timestamp('06 Oct 2026 07:00 +0000'), 'First historical test bar (UTC)')
if barstate.isfirst and (syminfo.tickerid != 'FOREXCOM:XAUUSD' or math.abs(syminfo.mincontract - 0.1) > 0.000000001)
    runtime.error('Requires FOREXCOM:XAUUSD and minimum contract 0.1')
// INCLUDE_QUANTITY_UNITS
precise(float value) => str.tostring(value, '0.0000000000000000')
var array<int> unitCases = array.from(1, 2, 3, 4, 5, 7, 10, 13, 20, 21, 22, 23, 30, 43, 64, 99, 125)
var int caseNumber = 0
var int phase = 0
var int requestBar = na
var int exitRequestBar = na
var int countedExits = 0
var int failures = 0
var int residualCases = 0
var int entryMismatchCases = 0
var float requestedQty = na
var bool usePartials = false
var int direction = 0
var string entryId = ''
var bool completed = false
int totalCases = array.size(unitCases) * 4
if barstate.isconfirmed and barstate.ishistory
    if strategy.closedtrades > countedExits
        for row = countedExits to strategy.closedtrades - 1
            log.info('QTY_MATRIX_EXIT ' + '{"entryId":"' + strategy.closedtrades.entry_id(row) + '","exitId":"' + strategy.closedtrades.exit_id(row) + '","comment":"' + strategy.closedtrades.exit_comment(row) + '","size":' + precise(strategy.closedtrades.size(row)) + ',"entryTime":' + str.tostring(strategy.closedtrades.entry_time(row)) + ',"exitTime":' + str.tostring(strategy.closedtrades.exit_time(row)) + '}')
        countedExits := strategy.closedtrades
    if phase == 0 and caseNumber < totalCases and time >= startTime and strategy.position_size == 0
        int count = array.size(unitCases)
        int units = array.get(unitCases, caseNumber % count)
        direction := caseNumber % (count * 2) < count ? 1 : -1
        usePartials := caseNumber < count * 2
        requestedQty := units * syminfo.mincontract
        entryId := 'MATRIX_' + str.tostring(caseNumber)
        log.info('QTY_MATRIX_REQUEST ' + '{"case":' + str.tostring(caseNumber) + ',"entryId":"' + entryId + '","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","partial":' + (usePartials ? 'true' : 'false') + ',"direction":' + str.tostring(direction) + ',"units":' + str.tostring(units) + ',"entryQty":' + precise(requestedQty) + ',"step":' + precise(syminfo.mincontract) + '}')
        strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, qty=requestedQty)
        requestBar := bar_index
        phase := 1
    else if phase == 1 and bar_index > requestBar
        if strategy.position_size != 0
            float actualQty = math.abs(strategy.position_size)
            bool entryMatches = math.abs(actualQty - requestedQty) < 0.000000001
            if not entryMatches
                entryMismatchCases += 1
            [q1, q2, q3] = exitQuantityUnits(requestedQty, syminfo.mincontract, usePartials)
            log.info('QTY_MATRIX_ALLOCATION ' + '{"case":' + str.tostring(caseNumber) + ',"entryId":"' + entryId + '","actualQty":' + precise(actualQty) + ',"entryMatches":' + (entryMatches ? 'true' : 'false') + ',"q1":' + precise(q1) + ',"q2":' + precise(q2) + ',"q3":' + precise(q3) + '}')
            float forcedStop = direction == 1 ? high * 2 : syminfo.mintick
            if q1 > 0
                strategy.exit('Q1', entryId, stop=forcedStop, qty=q1, comment_loss='MATRIX_BRACKET')
            if q2 > 0
                strategy.exit('Q2', entryId, stop=forcedStop, qty=q2, comment_loss='MATRIX_BRACKET')
            if q3 > 0
                strategy.exit('Q3', entryId, stop=forcedStop, qty=q3, comment_loss='MATRIX_BRACKET')
            exitRequestBar := bar_index
            phase := 2
        else if bar_index - requestBar > 3
            log.error('QTY_MATRIX_FAILURE entry did not fill: ' + entryId)
            failures += 1
            phase := 4
    else if phase == 2 and bar_index > exitRequestBar
        float remaining = math.abs(strategy.position_size)
        log.info('QTY_MATRIX_AFTER ' + '{"case":' + str.tostring(caseNumber) + ',"entryId":"' + entryId + '","remaining":' + precise(remaining) + '}')
        if remaining > 0
            residualCases += 1
            strategy.close(entryId, comment='MATRIX_CLEANUP', immediately=false)
            phase := 3
        else
            caseNumber += 1
            phase := 0
    else if phase == 3 and strategy.position_size == 0
        caseNumber += 1
        phase := 0
    if caseNumber == totalCases and not completed
        completed := true
        log.info('QTY_MATRIX_COMPLETE ' + '{"cases":' + str.tostring(totalCases) + ',"residualCases":' + str.tostring(residualCases) + ',"entryMismatchCases":' + str.tostring(entryMismatchCases) + ',"failures":' + str.tostring(failures) + '}')
plot(strategy.position_size, 'Synthetic quantity', display=display.data_window)
var table result = table.new(position.top_right, 2, 5)
if barstate.islast or barstate.islastconfirmedhistory
    table.cell(result, 0, 0, 'RESEARCH ONLY')
    table.cell(result, 1, 0, completed ? 'COMPLETE' : 'INCOMPLETE')
    table.cell(result, 0, 1, 'Cases completed')
    table.cell(result, 1, 1, str.tostring(caseNumber) + ' / ' + str.tostring(totalCases))
    table.cell(result, 0, 2, 'Residual cases')
    table.cell(result, 1, 2, str.tostring(residualCases))
    table.cell(result, 0, 3, 'Entry mismatches')
    table.cell(result, 1, 3, str.tostring(entryMismatchCases))
    table.cell(result, 0, 4, 'Failed cases')
    table.cell(result, 1, 4, str.tostring(failures))
