// Read-only Nov5 F-candidate snapshots; no trading state mutation or extra inputs.
traceInteger(int value) => na(value) ? 'null' : str.tostring(value)
tracePrice(float value) => na(value) ? 'null' : str.tostring(value, '#.################')
traceBoolean(bool value) => value ? 'true' : 'false'
// Fixed UTC bar-open bounds, both inclusive: 2026-11-05 11:05 through 12:20.
traceWindow(int barOpen) =>
    barOpen >= 1793876700000 and barOpen <= 1793881200000

researchNov5Trace(string phase, bool cancelling) =>
    if auditLog and timeframe.isminutes and timeframe.multiplier == 5 and barstate.isconfirmed and traceWindow(time)
        string prefix = '{"traceVersion":"1","variant":"' + TRACE_VARIANT + '","parentSha256":"' + TRACE_PARENT_SHA + '","symbol":"' + jsonEscape(syminfo.tickerid) + '","timeframe":"' + timeframe.period + '","barOpen":' + str.tostring(time) + ',"barClose":' + str.tostring(time_close) + ',"barIndex":' + str.tostring(bar_index) + ',"phase":"' + phase + '"'
        log.info('ENGINE_TRACE ' + prefix + ',"open":' + tracePrice(open) + ',"high":' + tracePrice(high) + ',"low":' + tracePrice(low) + ',"close":' + tracePrice(close) + ',"chartStructure":' + str.tostring(chartStructure) + ',"ema9":' + tracePrice(ema9) + ',"ema21":' + tracePrice(ema21) + ',"ema50":' + tracePrice(ema50) + ',"atr":' + tracePrice(atr) + ',"pullbackDepth":' + str.tostring(pullbackDepth) + ',"hTrend":' + str.tostring(hTrend) + ',"inSession":' + traceBoolean(inSession) + ',"volatilityAllowed":' + traceBoolean(volOK) + ',"useBroker":' + traceBoolean(useBroker) + ',"active":' + traceBoolean(active) + ',"pending":' + traceBoolean(pending) + ',"brokerBusy":' + traceBoolean(brokerBusy) + ',"cancelling":' + traceBoolean(cancelling) + ',"planSlotAvailable":' + traceBoolean(planSlotAvailable(active, pending, brokerBusy, cancelling)) + ',"sessionTrades":' + str.tostring(sessionTrades) + ',"quotaLimit":' + str.tostring(maxTrades) + ',"lastSignalBar":' + traceInteger(lastSignal) + ',"cooldownBars":' + str.tostring(cooldown) + ',"status":"' + jsonEscape(status) + '","validationReason":"' + jsonEscape(validationReason) + '","aStage":' + str.tostring(stage) + ',"direction":' + str.tostring(dir) + ',"selectedStrategy":"' + selectedStrategy + '","crtUsed":' + traceInteger(memory.crtUsed) + ',"turtleUsedLow":' + traceInteger(memory.turtleUsedLow) + ',"turtleUsedHigh":' + traceInteger(memory.turtleUsedHigh) + ',"swingHighBar":' + traceInteger(shBar) + ',"swingLowBar":' + traceInteger(slBar) + '}')
        for candidate in candidates
            log.info('CANDIDATE_TRACE ' + prefix + ',"id":"' + candidate.id + '","enabled":' + traceBoolean(candidate.enabled) + ',"stage":' + str.tostring(candidate.stage) + ',"direction":' + str.tostring(candidate.direction) + ',"setupBar":' + traceInteger(candidate.setupBar) + ',"setupTimestamp":' + traceInteger(candidate.setupTime) + ',"confirmationTimestamp":' + traceInteger(candidate.confirmationTime) + ',"readyBar":' + traceInteger(candidate.readyBar) + ',"ready":' + traceBoolean(candidate.ready) + ',"status":"' + jsonEscape(candidate.status) + '","mode":"' + jsonEscape(candidate.mode) + '","lower":' + tracePrice(candidate.lower) + ',"upper":' + tracePrice(candidate.upper) + ',"trigger":' + tracePrice(candidate.trigger) + ',"invalidation":' + tracePrice(candidate.invalidation) + ',"tests":' + str.tostring(candidate.tests) + ',"quality":' + str.tostring(candidate.quality) + ',"rejectionReason":"' + jsonEscape(candidate.rejectionReason) + '"}')
    0
