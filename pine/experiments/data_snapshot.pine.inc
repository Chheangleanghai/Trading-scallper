// DATA_SNAPSHOT_AUDIT_BEGIN — research logging only; no engine or alert mutations.
// The window uses chart-bar OPEN times, inclusively, in UTC.
dataSnapshotFloat(float value) => na(value) ? 'null' : str.tostring(value, '#.##########')
dataSnapshotInt(int value) => na(value) ? 'null' : str.tostring(value)
dataSnapshotBool(bool value) => value ? 'true' : 'false'
dataSnapshotCandidate(Candidate c) =>
    '{"id":"' + jsonEscape(c.id) + '","enabled":' + dataSnapshotBool(c.enabled) + ',"stage":' + str.tostring(c.stage) + ',"direction":' + str.tostring(c.direction) + ',"ready":' + dataSnapshotBool(c.ready) + ',"setupBar":' + dataSnapshotInt(c.setupBar) + ',"setupTime":' + dataSnapshotInt(c.setupTime) + ',"confirmationTime":' + dataSnapshotInt(c.confirmationTime) + ',"trigger":' + dataSnapshotFloat(c.trigger) + ',"lower":' + dataSnapshotFloat(c.lower) + ',"upper":' + dataSnapshotFloat(c.upper) + ',"invalidation":' + dataSnapshotFloat(c.invalidation) + ',"plannedEntry":' + dataSnapshotFloat(c.plannedEntry) + ',"quality":' + str.tostring(c.quality) + ',"status":"' + jsonEscape(c.status) + '","rejection":"' + jsonEscape(c.rejectionReason) + '"}'

var int dataSnapshotFirstLoadedTime = na
if barstate.isfirst
    dataSnapshotFirstLoadedTime := time
if barstate.isconfirmed and time >= timestamp('04 Nov 2026 09:30 +0000') and time <= timestamp('04 Nov 2026 10:20 +0000')
    string dataSnapshotCandidates = '['
    for snapshotIndex = 0 to array.size(candidates) - 1
        dataSnapshotCandidates += (snapshotIndex > 0 ? ',' : '') + dataSnapshotCandidate(array.get(candidates, snapshotIndex))
    dataSnapshotCandidates += ']'
    bool dataSnapshotPlanNow = newSignal and signalTime == time_close
    string dataSnapshotPlan = dataSnapshotPlanNow ? '{"timestamp":' + dataSnapshotInt(signalTime) + ',"setupTimestamp":' + dataSnapshotInt(signalSetupTime) + ',"strategy":"' + jsonEscape(selectedStrategy) + '","direction":' + str.tostring(dir) + ',"entryMode":"' + jsonEscape(entryMode) + '","entry":' + dataSnapshotFloat(entry) + ',"sl":' + dataSnapshotFloat(stop) + ',"tp1":' + dataSnapshotFloat(tp1) + ',"tp2":' + dataSnapshotFloat(tp2) + ',"tp3":' + dataSnapshotFloat(tp3) + ',"quality":' + str.tostring(quality) + '}' : 'null'
    string dataSnapshotPayload = '{"schema":"data-snapshot/v1","parentSourceSha256":"0a19862b22973e13a31abb29e59a75a18f3e0b84bb76deb2154eae7fa4cd1ed3","scriptVersion":"' + SCRIPT_VERSION + '","symbol":"' + jsonEscape(syminfo.tickerid) + '","timeframe":"' + timeframe.period + '","windowBasis":"BAR_OPEN_TIME","time":' + str.tostring(time) + ',"timeClose":' + str.tostring(time_close) + ',"barIndex":' + str.tostring(bar_index) + ',"lastBarIndex":' + str.tostring(last_bar_index) + ',"firstLoadedBarTime":' + dataSnapshotInt(dataSnapshotFirstLoadedTime) + ',"open":' + dataSnapshotFloat(open) + ',"high":' + dataSnapshotFloat(high) + ',"low":' + dataSnapshotFloat(low) + ',"close":' + dataSnapshotFloat(close) + ',"volume":' + dataSnapshotFloat(volume) + ',"mintick":' + dataSnapshotFloat(syminfo.mintick) + ',"atr":' + dataSnapshotFloat(atr) + ',"atrMean":' + dataSnapshotFloat(atrMean) + ',"ema9":' + dataSnapshotFloat(ema9) + ',"ema21":' + dataSnapshotFloat(ema21) + ',"ema50":' + dataSnapshotFloat(ema50) + ',"h1CompletedClose":' + dataSnapshotFloat(hClose) + ',"h1CompletedEMA50":' + dataSnapshotFloat(hEMA) + ',"hTrend":' + str.tostring(hTrend) + ',"mTrend":' + str.tostring(mTrend) + ',"crtTime":' + dataSnapshotInt(crtTime) + ',"crtHigh":' + dataSnapshotFloat(crtHigh) + ',"crtLow":' + dataSnapshotFloat(crtLow) + ',"pdh":' + dataSnapshotFloat(pdh) + ',"pdl":' + dataSnapshotFloat(pdl) + ',"pwh":' + dataSnapshotFloat(pwh) + ',"pwl":' + dataSnapshotFloat(pwl) + ',"swingHigh":' + dataSnapshotFloat(sh) + ',"swingLow":' + dataSnapshotFloat(slw) + ',"swingHighBar":' + dataSnapshotInt(shBar) + ',"swingLowBar":' + dataSnapshotInt(slBar) + ',"chartStructure":' + str.tostring(chartStructure) + ',"aStage":' + str.tostring(stage) + ',"direction":' + str.tostring(dir) + ',"active":' + dataSnapshotBool(active) + ',"pending":' + dataSnapshotBool(pending) + ',"brokerBusy":' + dataSnapshotBool(brokerBusy) + ',"cancelOrder":' + dataSnapshotBool(cancelOrder) + ',"slotAvailable":' + dataSnapshotBool(planSlotAvailable(active, pending, brokerBusy, cancelOrder)) + ',"sessionTrades":' + str.tostring(sessionTrades) + ',"maximumPlans":' + str.tostring(maxTrades) + ',"lastSignalBar":' + dataSnapshotInt(lastSignal) + ',"cooldownBars":' + str.tostring(cooldown) + ',"signalTime":' + dataSnapshotInt(signalTime) + ',"signalBar":' + dataSnapshotInt(signalBar) + ',"fillBar":' + dataSnapshotInt(fillBar) + ',"selectedStrategy":"' + jsonEscape(selectedStrategy) + '","status":"' + jsonEscape(status) + '","inSession":' + dataSnapshotBool(inSession) + ',"volatilityAllowed":' + dataSnapshotBool(volOK) + ',"paused":' + dataSnapshotBool(pause) + ',"decisionReason":"' + jsonEscape(decisionReason) + '","plan":' + dataSnapshotPlan + ',"candidates":' + dataSnapshotCandidates + '}'
    log.info('DATA_SNAPSHOT_AUDIT ' + dataSnapshotPayload)
